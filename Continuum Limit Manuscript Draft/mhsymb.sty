\ProvidesPackage{mhsymb}
\RequirePackage{ifthen}
\RequirePackage{color}
\def\eref#1{(\ref{#1})}
\newcommand{\eqdef}{\coloneqq}
\newcommand{\defeq}{\eqqcolon}
\newcommand{\eqlaw}{\stackrel{\mbox{\tiny\rm law}}{=}}
\newcommand{\convlaw}{\stackrel{\mbox{\tiny\rm law}}{\to}}
\newcommand{\one}{\mathbf{1}}
\let\mathcal\mathcal
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
%  Intermediates between \big and \Big
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\def\sm#1{{\hbox{$\left#1\right.\n@space$}}}
\def\sml{\mathopen\sm}
\def\smr{\mathclose\sm}
\let\@oldleft\left
\let\@oldright\right
\def\left#1{\bgroup\@oldleft#1}
\def\right#1{\@oldright#1\egroup}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
%  Arrows
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\def\harr#1#2{\smash{\mathop{\hbox to .5in{\rightarrowfill}}
        \limits^{\scriptstyle#1}_{\scriptstyle#2}}}
\def\varr#1#2{\llap{$\scriptstyle#1$}\left\downarrow
        \vcenter to .5in{}\right.\rlap{$\scriptstyle #2$}}
\def\diagram#1{{\normallineskip=8pt
        \normalbaselineskip=0pt \matrix{#1}}}
\newcommand{\down}{\ensuremath{\downarrow}}
\newcommand{\downl}{\ensuremath{\swarrow}}
\newcommand{\downr}{\ensuremath{\searrow}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
%  Miscellaneous symbols
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%\let\emptyset\phi
\let\phi\varphi
\let\orho\rho
\def\rho{\varrho}
\def\eps{\varepsilon}
\def\d{\partial}
\def\Ohm{\Omega}

\def\({\left(}
\def\){\right)}

\newcommand\symb[2][\bf]{{\mathchoice{\hbox{#1#2}}{\hbox{#1#2}}%
        {\hbox{\scriptsize#1#2}}{\hbox{\tiny#1#2}}}}

\def\Re{\symb[\rm]{Re}}
\def\Im{\symb[\rm]{Im}}
\def\L^#1{{\rm L}^{\!#1}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
%  Standard fields and groups
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\def\R{{\mathbb R}}
\def\N{{\mathbb N}}
\def\Z{{\mathbb Z}}
\newcommand{\C}{{\mathbb C}}
\def\Q{{\mathbb Q}}
\def\E{{\mathbb E}}
\def\P{{\mathbb P}}
\def\T{{\mathbb T}}
\def\K{{\mathbb K}}
\newcommand\sumd[4][3mm]{\sum^{#4}_{\substack{#2 \\ \rule{0cm}{#1} #3}}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
%  Hilbert spaces
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand\scal[2][ ]{\ifthenelse{\equal{#1}{ }}{\langle#2\rangle}{}
        \ifthenelse{\equal{#1}{b}}{\bigl\langle#2\bigr\rangle}{}
        \ifthenelse{\equal{#1}{B}}{\Bigl\langle#2\Bigr\rangle}{}
        \ifthenelse{\equal{#1}{bb}}{\biggl\langle#2\biggr\rangle}{}
        \ifthenelse{\equal{#1}{BB}}{\Biggl\langle#2\Biggr\rangle}{}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%   
%
%  Right Fonts for Commas
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\let\@pvOld=\;
\def\@text#1{\hbox{#1}}
\def\@pvNew{\@pvOld\@ifnextchar,{\@text}{}}
\let\;\@pvNew

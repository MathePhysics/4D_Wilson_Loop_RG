import FriedrichsExtension.EnergyCore
import Mathlib.Algebra.Module.Submodule.LinearMap
import Mathlib.Algebra.Module.TransferInstance
import Mathlib.Analysis.InnerProductSpace.Completion
import Mathlib.Analysis.Normed.Operator.Extend

open scoped InnerProductSpace

noncomputable section

namespace FriedrichsExtension
namespace SemiboundedSymmetricOperator

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/--
A dedicated copy of the operator domain carrying the shifted energy norm.

The parameters `shift` and `hshift` are part of the type so that its normed-space instance is
unambiguous. This avoids installing a second norm on the subtype `A.op.domain` itself.
-/
@[ext]
structure EnergyDomain (A : SemiboundedSymmetricOperator H) (shift : ℝ)
    (hshift : 0 < A.lowerBound + shift) where
  toDomain : A.op.domain

namespace EnergyDomain

variable (A : SemiboundedSymmetricOperator H) (shift : ℝ)
    (hshift : 0 < A.lowerBound + shift)

/-- The canonical equivalence with the original operator domain. -/
@[simps apply symm_apply]
def equiv : EnergyDomain A shift hshift ≃ A.op.domain where
  toFun := toDomain
  invFun := fun u => ⟨u⟩
  left_inv := by intro u; cases u; rfl
  right_inv := by intro u; rfl

instance instZero : Zero (EnergyDomain A shift hshift) := (equiv A shift hshift).zero
instance instAdd : Add (EnergyDomain A shift hshift) := (equiv A shift hshift).add
instance instNeg : Neg (EnergyDomain A shift hshift) := (equiv A shift hshift).Neg
instance instSMul : SMul ℝ (EnergyDomain A shift hshift) := (equiv A shift hshift).smul ℝ

instance instAddCommGroup : AddCommGroup (EnergyDomain A shift hshift) :=
  (equiv A shift hshift).addCommGroup

/-- The energy-domain copy is additively equivalent to the original operator domain. -/
@[simps! apply symm_apply]
def addEquiv : EnergyDomain A shift hshift ≃+ A.op.domain where
  toEquiv := equiv A shift hshift
  map_add' _ _ := rfl

instance instModule : Module ℝ (EnergyDomain A shift hshift) :=
  (addEquiv A shift hshift).module ℝ

/-- Linear equivalence back to the original operator domain. -/
@[simps! apply symm_apply]
def linearEquiv : EnergyDomain A shift hshift ≃ₗ[ℝ] A.op.domain where
  toAddEquiv := addEquiv A shift hshift
  map_smul' _ _ := rfl

@[simp]
theorem toDomain_zero : (0 : EnergyDomain A shift hshift).toDomain = 0 := rfl

@[simp]
theorem toDomain_add (u v : EnergyDomain A shift hshift) :
    (u + v).toDomain = u.toDomain + v.toDomain := rfl

@[simp]
theorem toDomain_neg (u : EnergyDomain A shift hshift) :
    (-u).toDomain = -u.toDomain := rfl

@[simp]
theorem toDomain_smul (c : ℝ) (u : EnergyDomain A shift hshift) :
    (c • u).toDomain = c • u.toDomain := rfl

/--
The shifted energy pre-inner-product transported to the dedicated energy-domain copy.

This is kept separate from `core` so that the inner-product-space constructor can be given its
input explicitly rather than asking typeclass inference to reconstruct it.
-/
@[instance_reducible]
def preCore : PreInnerProductSpace.Core ℝ (EnergyDomain A shift hshift) where
  inner u v := A.shiftedForm shift u.toDomain v.toDomain
  conj_inner_symm u v := by
    simpa using A.shiftedForm_symm shift v.toDomain u.toDomain
  re_inner_nonneg u := by
    have hnonneg : 0 ≤ (A.lowerBound + shift) * ‖(u.toDomain : H)‖ ^ 2 :=
      mul_nonneg hshift.le (sq_nonneg _)
    have h := hnonneg.trans (A.shiftedEnergy_lower shift u.toDomain)
    simpa [shiftedEnergy] using h
  add_left u v w := by
    change A.shiftedForm shift (u.toDomain + v.toDomain) w.toDomain = _
    exact A.shiftedForm_add_left shift u.toDomain v.toDomain w.toDomain
  smul_left u v c := by
    change A.shiftedForm shift (c • u.toDomain) v.toDomain = _
    simpa using A.shiftedForm_smul_left shift c u.toDomain v.toDomain

/-- The positive-definite shifted energy core on the dedicated domain copy. -/
@[instance_reducible]
def core : InnerProductSpace.Core ℝ (EnergyDomain A shift hshift) where
  __ := preCore A shift hshift
  definite u hu := by
    apply EnergyDomain.ext
    exact (A.shiftedEnergyCore shift hshift).definite u.toDomain hu

/-- The norm generated by the shifted energy scalar product. -/
@[instance_reducible]
noncomputable instance instNormedAddCommGroup : NormedAddCommGroup (EnergyDomain A shift hshift) :=
  @InnerProductSpace.Core.toNormedAddCommGroup ℝ (EnergyDomain A shift hshift) _ _ _
    (core A shift hshift)

/-- The inner product generated by the shifted energy scalar product and the preceding norm. -/
@[instance_reducible]
noncomputable instance instInnerProductSpace :
    @InnerProductSpace ℝ (EnergyDomain A shift hshift) _
      (instNormedAddCommGroup A shift hshift).toSeminormedAddCommGroup :=
  InnerProductSpace.ofCore (preCore A shift hshift)

@[simp]
theorem inner_eq_shiftedForm (u v : EnergyDomain A shift hshift) :
    inner ℝ u v = A.shiftedForm shift u.toDomain v.toDomain := by
  rfl

/-- The energy norm squared is exactly the shifted quadratic energy. -/
theorem norm_sq_eq_shiftedEnergy (u : EnergyDomain A shift hshift) :
    ‖u‖ ^ 2 = A.shiftedEnergy shift u.toDomain := by
  rw [← real_inner_self_eq_norm_sq, inner_eq_shiftedForm]
  rfl

/-- Coercivity controls the ambient Hilbert norm by the energy norm. -/
theorem ambient_norm_le (u : EnergyDomain A shift hshift) :
    ‖(u.toDomain : H)‖ ≤ (Real.sqrt (A.lowerBound + shift))⁻¹ * ‖u‖ := by
  let c : ℝ := A.lowerBound + shift
  have hc : 0 < c := hshift
  have hsqrt : 0 < Real.sqrt c := Real.sqrt_pos.2 hc
  have hsq : (Real.sqrt c * ‖(u.toDomain : H)‖) ^ 2 ≤ ‖u‖ ^ 2 := by
    rw [mul_pow, Real.sq_sqrt hc.le, norm_sq_eq_shiftedEnergy]
    exact A.shiftedEnergy_lower shift u.toDomain
  have hlin : Real.sqrt c * ‖(u.toDomain : H)‖ ≤ ‖u‖ :=
    (sq_le_sq₀ (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) (norm_nonneg _)).mp hsq
  calc
    ‖(u.toDomain : H)‖ = (Real.sqrt c)⁻¹ * (Real.sqrt c * ‖(u.toDomain : H)‖) := by
      rw [← mul_assoc, inv_mul_cancel₀ hsqrt.ne', one_mul]
    _ ≤ (Real.sqrt c)⁻¹ * ‖u‖ :=
      mul_le_mul_of_nonneg_left hlin (inv_nonneg.mpr hsqrt.le)
    _ = (Real.sqrt (A.lowerBound + shift))⁻¹ * ‖u‖ := rfl

/-- The underlying linear inclusion of the energy domain into the ambient Hilbert space. -/
def toAmbientLinear : EnergyDomain A shift hshift →ₗ[ℝ] H :=
  A.op.domain.subtype.comp (linearEquiv A shift hshift).toLinearMap

/-- The canonical bounded inclusion of the energy domain into the ambient Hilbert space. -/
def toAmbient : EnergyDomain A shift hshift →L[ℝ] H :=
  (toAmbientLinear A shift hshift).mkContinuous
    (Real.sqrt (A.lowerBound + shift))⁻¹ (ambient_norm_le A shift hshift)

@[simp]
theorem toAmbient_apply (u : EnergyDomain A shift hshift) :
    toAmbient A shift hshift u = (u.toDomain : H) := rfl

end EnergyDomain

/-- The Hilbert completion of the operator domain in the shifted energy norm. -/
abbrev EnergySpace (A : SemiboundedSymmetricOperator H) (shift : ℝ)
    (hshift : 0 < A.lowerBound + shift) :=
  UniformSpace.Completion (EnergyDomain A shift hshift)

section CompleteAmbient

variable [CompleteSpace H]
variable (A : SemiboundedSymmetricOperator H) (shift : ℝ)
    (hshift : 0 < A.lowerBound + shift)

/--
The canonical continuous map `J : V_shift → H` from the completed energy space to the ambient
Hilbert space.
-/
def energyEmbedding : EnergySpace A shift hshift →L[ℝ] H :=
  (EnergyDomain.toAmbient A shift hshift).fromCompletion

@[simp]
theorem energyEmbedding_coe (u : EnergyDomain A shift hshift) :
    energyEmbedding A shift hshift (u : EnergySpace A shift hshift) = (u.toDomain : H) := by
  simp [energyEmbedding, EnergyDomain.toAmbient_apply]

/-- The range of the energy embedding is dense because it contains the original dense operator domain. -/
theorem energyEmbedding_range_dense :
    Dense ((energyEmbedding A shift hshift).range : Set H) := by
  refine A.dense_domain.mono ?_
  intro x hx
  let u0 : A.op.domain := ⟨x, hx⟩
  let u : EnergyDomain A shift hshift := ⟨u0⟩
  refine ⟨(u : EnergySpace A shift hshift), ?_⟩
  simp [u, u0]

end CompleteAmbient

end SemiboundedSymmetricOperator
end FriedrichsExtension

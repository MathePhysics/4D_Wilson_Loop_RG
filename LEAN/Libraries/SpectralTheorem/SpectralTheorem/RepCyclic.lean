import SpectralTheorem.RepSpectralMeasure
import SpectralTheorem.Cyclic

/-!
# Cyclic subspaces of a representation of `C(X)`

Let `X` be a compact Hausdorff space, `π : C(X, ℂ) → 𝓛(H)` a unital `⋆`-representation and
`ψ ∈ H`.  The cyclic subspace `H_ψ` of `ψ` is the closure of `{π(f) ψ : f ∈ C(X, ℂ)}`.
Reed–Simon I, §VII.2, Lemma 1, p. 226, for the continuous functional calculus of a bounded
self-adjoint operator: there is a unitary `L²(σ(A), dμ_ψ) ≃ H_ψ` intertwining multiplication by
`λ` with `A`.  The same proof works for an arbitrary representation: `U f = π(f) ψ` for
continuous `f` is well defined and
isometric because `‖π(f) ψ‖² = ∫ |f|² dμ_ψ` (`integral_norm_sq_repMeasure`), extends by
continuity, and its range is `H_ψ` because `C(X)` is dense in `L²(X, dμ_ψ)`; multiplication by a
continuous `g` corresponds to `π(g)`.  The proofs are those of `SpectralTheorem.Cyclic`, with `X`
and `π` in place of `σ(T)` and `cfcHom`; the density of `C(X)` uses only that `μ_ψ` is finite and
regular, not that `X` is metrizable.

## Main definitions and results

* `SpectralTheorem.repCyclicSubmodule π ψ`: the closed subspace `H_ψ` generated by `ψ`.
* `SpectralTheorem.mapsTo_rep_repCyclicSubmodule`: `H_ψ` is invariant under every `π(g)`.
* `SpectralTheorem.repCyclicIsometry π ψ`: the linear isometry `L²(X, μ_ψ) → H`,
  `f ↦ π(f) ψ`; `repCyclicIsometry_toLp`, `range_repCyclicIsometry`.
* `SpectralTheorem.repCyclicEquiv π ψ`: the unitary `L²(X, μ_ψ) ≃ H_ψ`.
* `SpectralTheorem.repCyclicIsometry_smul`, `repCyclicIsometry_mul`: `U (g φ) = π(g) (U φ)`.
* `SpectralTheorem.mapsTo_orthogonal_rep`: the orthogonal complement of a subspace invariant
  under every `π(g)` is invariant under every `π(g)`.
* `SpectralTheorem.repCyclicSubmodule_isOrtho`: if `φ ⊥ H_ψ` then `H_φ ⊥ H_ψ`.
-/

noncomputable section

open scoped InnerProductSpace ComplexConjugate ENNReal
open MeasureTheory

namespace SpectralTheorem

universe u

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {X : Type u} [TopologicalSpace X]
variable (π : C(X, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H))

/-! ### The cyclic subspace -/

/-- The linear map `f ↦ π(f) ψ` from continuous functions on `X` to `H`. -/
def repCyclicMap (ψ : H) : C(X, ℂ) →ₗ[ℂ] H where
  toFun f := π f ψ
  map_add' f g := by rw [map_add, add_apply]
  map_smul' c f := by rw [map_smul, FunLike.coe_smul, Pi.smul_apply, RingHom.id_apply]

/-- `repCyclicMap π ψ f = π(f) ψ`. -/
@[simp]
theorem repCyclicMap_apply (ψ : H) (f : C(X, ℂ)) : repCyclicMap π ψ f = π f ψ :=
  rfl

/-- **The cyclic subspace** `H_ψ` of `ψ` for `π`: the closure of `{π(f) ψ : f ∈ C(X, ℂ)}`. -/
def repCyclicSubmodule (ψ : H) : Submodule ℂ H :=
  (LinearMap.range (repCyclicMap π ψ)).topologicalClosure

/-- The cyclic subspace is closed. -/
theorem isClosed_repCyclicSubmodule (ψ : H) : IsClosed (repCyclicSubmodule π ψ : Set H) :=
  Submodule.isClosed_topologicalClosure _

/-- `π(f) ψ ∈ H_ψ` for every continuous `f`. -/
theorem rep_apply_mem_repCyclicSubmodule (ψ : H) (f : C(X, ℂ)) :
    π f ψ ∈ repCyclicSubmodule π ψ :=
  (LinearMap.range (repCyclicMap π ψ)).le_topologicalClosure ⟨f, rfl⟩

/-- `ψ ∈ H_ψ`. -/
theorem mem_repCyclicSubmodule_self (ψ : H) : ψ ∈ repCyclicSubmodule π ψ := by
  simpa using rep_apply_mem_repCyclicSubmodule π ψ 1

/-- `H_ψ` is the smallest closed subspace containing every `π(f) ψ`. -/
theorem repCyclicSubmodule_le {ψ : H} {K : Submodule ℂ H} (hK : IsClosed (K : Set H))
    (h : ∀ f : C(X, ℂ), π f ψ ∈ K) : repCyclicSubmodule π ψ ≤ K :=
  Submodule.topologicalClosure_minimal _ (by rintro _ ⟨f, rfl⟩; exact h f) hK

/-- The cyclic subspace is invariant under every `π(g)`. -/
theorem mapsTo_rep_repCyclicSubmodule (ψ : H) (g : C(X, ℂ)) :
    Set.MapsTo (π g) (repCyclicSubmodule π ψ : Set H) (repCyclicSubmodule π ψ) := by
  rw [repCyclicSubmodule, Submodule.topologicalClosure_coe]
  refine Set.MapsTo.closure ?_ (π g).continuous
  rintro _ ⟨f, rfl⟩
  exact ⟨g * f, by simp [map_mul, mul_apply_eq_comp]⟩

/-! ### Invariant subspaces and orthogonality -/

/-- If a subspace `K` is invariant under every `π(g)`, so is its orthogonal complement `Kᗮ`,
because `π(g)† = π(conj g)` maps `K` into `K`. -/
theorem mapsTo_orthogonal_rep {K : Submodule ℂ H}
    (hK : ∀ g : C(X, ℂ), Set.MapsTo (π g) (K : Set H) K)
    (g : C(X, ℂ)) : Set.MapsTo (π g) (Kᗮ : Set H) Kᗮ := by
  intro x hx
  rw [SetLike.mem_coe, Submodule.mem_orthogonal] at hx ⊢
  intro u hu
  rw [← ContinuousLinearMap.adjoint_inner_left, ← ContinuousLinearMap.star_eq_adjoint,
    ← map_star]
  exact hx _ (hK (star g) hu)

/-- A closed subspace invariant under every `π(g)` contains the cyclic subspace of each of its
vectors. -/
theorem repCyclicSubmodule_le_of_mem {K : Submodule ℂ H} (hK : IsClosed (K : Set H))
    (hinv : ∀ g : C(X, ℂ), Set.MapsTo (π g) (K : Set H) K) {φ : H}
    (hφ : φ ∈ K) : repCyclicSubmodule π φ ≤ K :=
  repCyclicSubmodule_le π hK fun f => hinv f hφ

/-- If `φ ∈ H_ψ` then `H_φ ≤ H_ψ`. -/
theorem repCyclicSubmodule_le_repCyclicSubmodule {φ ψ : H} (h : φ ∈ repCyclicSubmodule π ψ) :
    repCyclicSubmodule π φ ≤ repCyclicSubmodule π ψ :=
  repCyclicSubmodule_le_of_mem π (isClosed_repCyclicSubmodule π ψ)
    (mapsTo_rep_repCyclicSubmodule π ψ) h

/-- If `φ ⊥ H_ψ` then `H_φ ⊥ H_ψ`. -/
theorem repCyclicSubmodule_isOrtho {φ ψ : H} (h : φ ∈ (repCyclicSubmodule π ψ)ᗮ) :
    repCyclicSubmodule π φ ⟂ repCyclicSubmodule π ψ :=
  Submodule.isOrtho_iff_le.mpr <|
    repCyclicSubmodule_le_of_mem π (Submodule.isClosed_orthogonal _)
      (mapsTo_orthogonal_rep π (mapsTo_rep_repCyclicSubmodule π ψ)) h

/-! ### The cyclic isometry -/

variable [CompactSpace X] [T2Space X] [MeasurableSpace X] [BorelSpace X]

/-- The inner product of `π(f) ψ` and `π(g) ψ` is the `L²(μ_ψ)` inner product of `f` and `g`. -/
theorem inner_rep_apply_eq_inner_toLp (ψ : H) (f g : C(X, ℂ)) :
    ⟪π f ψ, π g ψ⟫_ℂ =
      ⟪ContinuousMap.toLp 2 (repMeasure π ψ) ℂ f,
        ContinuousMap.toLp 2 (repMeasure π ψ) ℂ g⟫_ℂ := by
  rw [ContinuousMap.inner_toLp]
  have h := integral_repMeasure π ψ (star f * g)
  rw [map_mul, map_star, ContinuousLinearMap.star_eq_adjoint, mul_apply_eq_comp,
    ContinuousLinearMap.adjoint_inner_right] at h
  rw [← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp [mul_comm]

/-- `‖π(f) ψ‖` is the `L²(μ_ψ)` norm of `f`. -/
theorem norm_rep_apply_eq_norm_toLp (ψ : H) (f : C(X, ℂ)) :
    ‖π f ψ‖ = ‖ContinuousMap.toLp 2 (repMeasure π ψ) ℂ f‖ := by
  have h := inner_rep_apply_eq_inner_toLp π ψ f f
  rw [inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K] at h
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp (by exact_mod_cast h)

/-- Continuous functions are dense in `L²(X, μ_ψ)`: `μ_ψ` is finite and regular, hence weakly
regular, and `X` is normal. -/
theorem denseRange_toLp_repMeasure (ψ : H) :
    DenseRange (ContinuousMap.toLp 2 (repMeasure π ψ) ℂ :
      C(X, ℂ) →L[ℂ] Lp ℂ 2 (repMeasure π ψ)) :=
  ContinuousMap.toLp_denseRange ℂ (repMeasure π ψ) ℂ ENNReal.ofNat_ne_top

/-- **The cyclic isometry** `U : L²(X, μ_ψ) → H` (Reed–Simon I, §VII.2, Lemma 1, p. 226, there
in the inverse direction and for the functional calculus of one operator): the continuous
extension of `f ↦ π(f) ψ` from continuous `f`. -/
def repCyclicIsometry (ψ : H) : Lp ℂ 2 (repMeasure π ψ) →ₗᵢ[ℂ] H :=
  (repCyclicMap π ψ).extendOfIsometry
    (e := (ContinuousMap.toLp 2 (repMeasure π ψ) ℂ).toLinearMap)
    (denseRange_toLp_repMeasure π ψ) (norm_rep_apply_eq_norm_toLp π ψ)

/-- `U f = π(f) ψ` for continuous `f`. -/
@[simp]
theorem repCyclicIsometry_toLp (ψ : H) (f : C(X, ℂ)) :
    repCyclicIsometry π ψ (ContinuousMap.toLp 2 (repMeasure π ψ) ℂ f) = π f ψ :=
  LinearMap.extendOfIsometry_eq _ _ _ f

/-- The range of the cyclic isometry is the cyclic subspace. -/
theorem range_repCyclicIsometry (ψ : H) :
    LinearMap.range (repCyclicIsometry π ψ).toLinearMap = repCyclicSubmodule π ψ := by
  apply le_antisymm
  · rintro _ ⟨φ, rfl⟩
    have hmaps : Set.MapsTo (repCyclicIsometry π ψ)
        (Set.range (ContinuousMap.toLp 2 (repMeasure π ψ) ℂ))
        (Set.range (repCyclicMap π ψ)) := by
      rintro _ ⟨f, rfl⟩
      exact ⟨f, (repCyclicIsometry_toLp π ψ f).symm⟩
    have h := hmaps.closure (repCyclicIsometry π ψ).continuous
      (denseRange_toLp_repMeasure π ψ φ)
    rwa [repCyclicSubmodule, ← SetLike.mem_coe, Submodule.topologicalClosure_coe,
      LinearMap.coe_range]
  · refine repCyclicSubmodule_le π ?_ fun f => ⟨_, repCyclicIsometry_toLp π ψ f⟩
    rw [LinearMap.coe_range]
    exact (repCyclicIsometry π ψ).isometry.isUniformInducing.isComplete_range.isClosed

/-- The cyclic isometry maps into the cyclic subspace. -/
theorem repCyclicIsometry_mem (ψ : H) (φ : Lp ℂ 2 (repMeasure π ψ)) :
    repCyclicIsometry π ψ φ ∈ repCyclicSubmodule π ψ := by
  rw [← range_repCyclicIsometry]
  exact ⟨φ, rfl⟩

/-- **Reed–Simon I, §VII.2, Lemma 1** (p. 226) for a representation: the unitary
`L²(X, μ_ψ) ≃ H_ψ`, `f ↦ π(f) ψ` for continuous `f`. -/
def repCyclicEquiv (ψ : H) : Lp ℂ 2 (repMeasure π ψ) ≃ₗᵢ[ℂ] repCyclicSubmodule π ψ :=
  (repCyclicIsometry π ψ).equivRange.trans
    (LinearIsometryEquiv.ofEq _ _ (range_repCyclicIsometry π ψ))

/-- The unitary `repCyclicEquiv π ψ` is the cyclic isometry with its codomain restricted to
`H_ψ`. -/
@[simp]
theorem coe_repCyclicEquiv_apply (ψ : H) (φ : Lp ℂ 2 (repMeasure π ψ)) :
    (repCyclicEquiv π ψ φ : H) = repCyclicIsometry π ψ φ :=
  rfl

/-! ### Intertwining: `U⁻¹ π(g) U` is multiplication by `g` -/

/-- **Intertwining** (Reed–Simon I, §VII.2, Lemma 1, p. 226, for a representation):
`U (g • φ) = π(g) (U φ)` for continuous `g` and `φ ∈ L²(μ_ψ)`, where `g • φ` is the Hölder
product of the `L^∞` class of `g` with `φ`.  Equivalently `U⁻¹ π(g) U` is multiplication by `g`
on `L²(X, μ_ψ)`. -/
theorem repCyclicIsometry_smul (ψ : H) (g : C(X, ℂ)) (φ : Lp ℂ 2 (repMeasure π ψ)) :
    repCyclicIsometry π ψ
        (ContinuousMap.toLp ∞ (repMeasure π ψ) ℂ g • φ : Lp ℂ 2 (repMeasure π ψ)) =
      π g (repCyclicIsometry π ψ φ) := by
  refine (denseRange_toLp_repMeasure π ψ).induction_on φ
    (isClosed_eq ((repCyclicIsometry π ψ).continuous.comp (continuous_lpSMul _))
      ((π g).continuous.comp (repCyclicIsometry π ψ).continuous)) fun f => ?_
  rw [toLp_top_smul_toLp, repCyclicIsometry_toLp, repCyclicIsometry_toLp, map_mul,
    mul_apply_eq_comp]

/-- **Intertwining**, pointwise form: `U (g φ) = π(g) (U φ)`, where `g φ` is the `L²` class of
`x ↦ g x * φ x`. -/
theorem repCyclicIsometry_mul (ψ : H) (g : C(X, ℂ)) (φ : Lp ℂ 2 (repMeasure π ψ)) :
    repCyclicIsometry π ψ ((memLp_continuousMap_mul g φ).toLp (fun x => g x * φ x)) =
      π g (repCyclicIsometry π ψ φ) := by
  rw [← toLp_top_smul_eq_toLp, repCyclicIsometry_smul]

/-- **Reed–Simon I, §VII.2, Lemma 1** (p. 226) in their direction, for a representation: the
inverse unitary `V : H_ψ → L²(X, μ_ψ)` satisfies `V (π(g) x) = g • V x` for `x ∈ H_ψ` and
continuous `g`. -/
theorem repCyclicEquiv_symm_rep (ψ : H) (g : C(X, ℂ)) (x : repCyclicSubmodule π ψ) :
    (repCyclicEquiv π ψ).symm ⟨π g x, mapsTo_rep_repCyclicSubmodule π ψ g x.2⟩ =
      (ContinuousMap.toLp ∞ (repMeasure π ψ) ℂ g • (repCyclicEquiv π ψ).symm x :
        Lp ℂ 2 (repMeasure π ψ)) := by
  rw [LinearIsometryEquiv.symm_apply_eq]
  ext
  rw [coe_repCyclicEquiv_apply, repCyclicIsometry_smul, ← coe_repCyclicEquiv_apply,
    LinearIsometryEquiv.apply_symm_apply]

end SpectralTheorem

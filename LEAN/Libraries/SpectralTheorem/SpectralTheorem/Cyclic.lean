import SpectralTheorem.SpectralMeasure
import Mathlib.Analysis.Normed.Operator.Extend
import Mathlib.MeasureTheory.Function.ContinuousMapDense
import Mathlib.MeasureTheory.Function.Holder
import Mathlib.MeasureTheory.Function.L2Space

/-!
# Cyclic subspaces of a bounded normal operator

Let `T` be a bounded normal operator on a complex Hilbert space `H` and `ψ ∈ H`.  The cyclic
subspace `H_ψ` of `ψ` is the closure of `{f(T) ψ : f ∈ C(σ(T), ℂ)}`.  Reed–Simon I, §VII.2,
Lemma 1, p. 226: if `ψ` is cyclic for a bounded self-adjoint `A`, there is a unitary
`U : H → L²(σ(A), dμ_ψ)` with `(U A U⁻¹ f)(λ) = λ f(λ)`, where `μ_ψ` is the spectral measure of
`ψ`.  Their proof: `U (f(A) ψ) = f` for continuous `f` is well defined and isometric because
`‖f(A) ψ‖² = ∫ |f|² dμ_ψ`, extends by continuity, and is onto because `C(σ(A))` is dense in
`L²(σ(A), dμ_ψ)`.  The same proof works for normal `T` and, without assuming `ψ` cyclic, gives a
unitary `L²(σ(T), dμ_ψ) ≃ H_ψ`, which is what we prove.  Reed–Simon call `ψ` cyclic when the
vectors `Aⁿ ψ` span a dense subspace; by the Weierstrass theorem this is the same as density of
`{f(A) ψ : f ∈ C(σ(A))}`, which is the form their proof uses and the one taken here.

We construct the inverse of Reed–Simon's map, the isometry `U : L²(σ(T), dμ_ψ) → H` (called `U`
below), with `U f = f(T) ψ` for continuous `f`, extended by continuity
(`LinearMap.extendOfIsometry`).

## Main definitions

* `SpectralTheorem.cyclicSubmodule T ψ`: the closed subspace `H_ψ` generated by `ψ`.
* `SpectralTheorem.cyclicIsometry T ψ`: the linear isometry `L²(σ(T), μ_ψ) → H`, `f ↦ f(T) ψ`.
* `SpectralTheorem.cyclicEquiv T ψ`: the unitary `L²(σ(T), μ_ψ) ≃ H_ψ`.

## Main results

* `SpectralTheorem.cyclicIsometry_toLp`: `U f = f(T) ψ` for continuous `f`.
* `SpectralTheorem.range_cyclicIsometry`: the range of `U` is `H_ψ`.
* `SpectralTheorem.cyclicIsometry_smul`: `U (g • φ) = g(T) (U φ)` for continuous `g` and
  `φ ∈ L²(μ_ψ)`, where `g • φ` is the Hölder product of `g ∈ L^∞` and `φ ∈ L²`;
  `SpectralTheorem.cyclicIsometry_mul` is the same with `g • φ` written as the `L²` class of
  `x ↦ g x * φ x`, and `SpectralTheorem.cyclicIsometry_mul_id` is the case `g = id`: `U⁻¹ T U` is
  multiplication by the variable (Reed–Simon I, p. 226).
* `SpectralTheorem.cyclicEquiv_symm_cfcHom`: the same for the inverse unitary `H_ψ → L²`.
* `SpectralTheorem.mapsTo_orthogonal`: the orthogonal complement of a subspace invariant under
  every `g(T)` is invariant under every `g(T)`.
* `SpectralTheorem.cyclicSubmodule_isOrtho`: if `φ ⊥ H_ψ` then `H_φ ⊥ H_ψ`.
-/

noncomputable section

open scoped InnerProductSpace ComplexConjugate ENNReal
open MeasureTheory

namespace SpectralTheorem

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (T : H →L[ℂ] H) [hT : IsStarNormal T]

/-! ### The cyclic subspace -/

/-- The linear map `f ↦ f(T) ψ` from continuous functions on the spectrum to `H`. -/
def cyclicMap (ψ : H) : C(spectrum ℂ T, ℂ) →ₗ[ℂ] H where
  toFun f := cfcHom hT f ψ
  map_add' f g := by rw [map_add, add_apply]
  map_smul' c f := by rw [map_smul, FunLike.coe_smul, Pi.smul_apply, RingHom.id_apply]

/-- `cyclicMap T ψ f = f(T) ψ`. -/
@[simp]
theorem cyclicMap_apply (ψ : H) (f : C(spectrum ℂ T, ℂ)) : cyclicMap T ψ f = cfcHom hT f ψ :=
  rfl

/-- **The cyclic subspace** `H_ψ` of `ψ` (Reed–Simon I, p. 226): the closure of
`{f(T) ψ : f ∈ C(σ(T), ℂ)}`. -/
def cyclicSubmodule (ψ : H) : Submodule ℂ H :=
  (LinearMap.range (cyclicMap T ψ)).topologicalClosure

/-- The cyclic subspace is closed. -/
theorem isClosed_cyclicSubmodule (ψ : H) : IsClosed (cyclicSubmodule T ψ : Set H) :=
  Submodule.isClosed_topologicalClosure _

/-- `f(T) ψ ∈ H_ψ` for every continuous `f`. -/
theorem cfcHom_apply_mem_cyclicSubmodule (ψ : H) (f : C(spectrum ℂ T, ℂ)) :
    cfcHom hT f ψ ∈ cyclicSubmodule T ψ :=
  (LinearMap.range (cyclicMap T ψ)).le_topologicalClosure ⟨f, rfl⟩

/-- `ψ ∈ H_ψ`. -/
theorem mem_cyclicSubmodule_self (ψ : H) : ψ ∈ cyclicSubmodule T ψ := by
  simpa using cfcHom_apply_mem_cyclicSubmodule T ψ 1

/-- `H_ψ` is the smallest closed subspace containing every `f(T) ψ`. -/
theorem cyclicSubmodule_le {ψ : H} {K : Submodule ℂ H} (hK : IsClosed (K : Set H))
    (h : ∀ f : C(spectrum ℂ T, ℂ), cfcHom hT f ψ ∈ K) : cyclicSubmodule T ψ ≤ K :=
  Submodule.topologicalClosure_minimal _ (by rintro _ ⟨f, rfl⟩; exact h f) hK

/-- The cyclic subspace is invariant under every `g(T)`, in particular under `T` and `T†`. -/
theorem mapsTo_cfcHom_cyclicSubmodule (ψ : H) (g : C(spectrum ℂ T, ℂ)) :
    Set.MapsTo (cfcHom hT g) (cyclicSubmodule T ψ : Set H) (cyclicSubmodule T ψ) := by
  rw [cyclicSubmodule, Submodule.topologicalClosure_coe]
  refine Set.MapsTo.closure ?_ (cfcHom hT g).continuous
  rintro _ ⟨f, rfl⟩
  exact ⟨g * f, by simp [map_mul, mul_apply_eq_comp]⟩

/-- The cyclic subspace is invariant under `T`. -/
theorem mapsTo_cyclicSubmodule (ψ : H) :
    Set.MapsTo T (cyclicSubmodule T ψ : Set H) (cyclicSubmodule T ψ) := by
  have h := mapsTo_cfcHom_cyclicSubmodule T ψ ((ContinuousMap.id ℂ).restrict (spectrum ℂ T))
  rwa [cfcHom_id] at h

/-- The cyclic subspace is invariant under `T†`. -/
theorem mapsTo_adjoint_cyclicSubmodule (ψ : H) :
    Set.MapsTo (ContinuousLinearMap.adjoint T) (cyclicSubmodule T ψ : Set H)
      (cyclicSubmodule T ψ) := by
  have h :=
    mapsTo_cfcHom_cyclicSubmodule T ψ (star ((ContinuousMap.id ℂ).restrict (spectrum ℂ T)))
  rwa [map_star, cfcHom_id, ContinuousLinearMap.star_eq_adjoint] at h

/-! ### The cyclic isometry -/

/-- The inner product of `f(T) ψ` and `g(T) ψ` is the `L²(μ_ψ)` inner product of `f` and `g`. -/
theorem inner_cfcHom_apply_eq_inner_toLp (ψ : H) (f g : C(spectrum ℂ T, ℂ)) :
    ⟪cfcHom hT f ψ, cfcHom hT g ψ⟫_ℂ =
      ⟪ContinuousMap.toLp 2 (spectralMeasure T ψ) ℂ f,
        ContinuousMap.toLp 2 (spectralMeasure T ψ) ℂ g⟫_ℂ := by
  rw [ContinuousMap.inner_toLp]
  have h := integral_spectralMeasure T ψ (star f * g)
  rw [map_mul, map_star, ContinuousLinearMap.star_eq_adjoint, mul_apply_eq_comp,
    ContinuousLinearMap.adjoint_inner_right] at h
  rw [← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp [mul_comm]

/-- `‖f(T) ψ‖` is the `L²(μ_ψ)` norm of `f` (Reed–Simon I, p. 226). -/
theorem norm_cfcHom_apply_eq_norm_toLp (ψ : H) (f : C(spectrum ℂ T, ℂ)) :
    ‖cfcHom hT f ψ‖ = ‖ContinuousMap.toLp 2 (spectralMeasure T ψ) ℂ f‖ := by
  have h := inner_cfcHom_apply_eq_inner_toLp T ψ f f
  rw [inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K] at h
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp (by exact_mod_cast h)

/-- Continuous functions are dense in `L²(σ(T), μ_ψ)`. -/
theorem denseRange_toLp (ψ : H) :
    DenseRange (ContinuousMap.toLp 2 (spectralMeasure T ψ) ℂ :
      C(spectrum ℂ T, ℂ) →L[ℂ] Lp ℂ 2 (spectralMeasure T ψ)) :=
  ContinuousMap.toLp_denseRange ℂ (spectralMeasure T ψ) ℂ ENNReal.ofNat_ne_top

/-- **The cyclic isometry** `U : L²(σ(T), μ_ψ) → H` of Reed–Simon I, §VII.2, Lemma 1, p. 226
(there in the inverse direction): the continuous extension of `f ↦ f(T) ψ` from continuous `f`. -/
def cyclicIsometry (ψ : H) : Lp ℂ 2 (spectralMeasure T ψ) →ₗᵢ[ℂ] H :=
  (cyclicMap T ψ).extendOfIsometry
    (e := (ContinuousMap.toLp 2 (spectralMeasure T ψ) ℂ).toLinearMap)
    (denseRange_toLp T ψ) (norm_cfcHom_apply_eq_norm_toLp T ψ)

/-- `U f = f(T) ψ` for continuous `f`. -/
@[simp]
theorem cyclicIsometry_toLp (ψ : H) (f : C(spectrum ℂ T, ℂ)) :
    cyclicIsometry T ψ (ContinuousMap.toLp 2 (spectralMeasure T ψ) ℂ f) = cfcHom hT f ψ :=
  LinearMap.extendOfIsometry_eq _ _ _ f

/-- The range of the cyclic isometry is the cyclic subspace. -/
theorem range_cyclicIsometry (ψ : H) :
    LinearMap.range (cyclicIsometry T ψ).toLinearMap = cyclicSubmodule T ψ := by
  apply le_antisymm
  · rintro _ ⟨φ, rfl⟩
    have hmaps : Set.MapsTo (cyclicIsometry T ψ)
        (Set.range (ContinuousMap.toLp 2 (spectralMeasure T ψ) ℂ)) (Set.range (cyclicMap T ψ)) := by
      rintro _ ⟨f, rfl⟩
      exact ⟨f, (cyclicIsometry_toLp T ψ f).symm⟩
    have h := hmaps.closure (cyclicIsometry T ψ).continuous (denseRange_toLp T ψ φ)
    rwa [cyclicSubmodule, ← SetLike.mem_coe, Submodule.topologicalClosure_coe,
      LinearMap.coe_range]
  · refine cyclicSubmodule_le T ?_ fun f => ⟨_, cyclicIsometry_toLp T ψ f⟩
    rw [LinearMap.coe_range]
    exact (cyclicIsometry T ψ).isometry.isUniformInducing.isComplete_range.isClosed

/-- **Reed–Simon I, §VII.2, Lemma 1** (p. 226): the unitary `L²(σ(T), μ_ψ) ≃ H_ψ`,
`f ↦ f(T) ψ` for continuous `f`. -/
def cyclicEquiv (ψ : H) : Lp ℂ 2 (spectralMeasure T ψ) ≃ₗᵢ[ℂ] cyclicSubmodule T ψ :=
  (cyclicIsometry T ψ).equivRange.trans (LinearIsometryEquiv.ofEq _ _ (range_cyclicIsometry T ψ))

/-- The unitary `cyclicEquiv T ψ` is the cyclic isometry with its codomain restricted to
`H_ψ`. -/
@[simp]
theorem coe_cyclicEquiv_apply (ψ : H) (φ : Lp ℂ 2 (spectralMeasure T ψ)) :
    (cyclicEquiv T ψ φ : H) = cyclicIsometry T ψ φ :=
  rfl

/-! ### Intertwining: `U⁻¹ g(T) U` is multiplication by `g` -/

section Multiplication

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

/-- Multiplication by a fixed `L^∞` function is continuous on `L²`. -/
theorem continuous_lpSMul (G : Lp ℂ ∞ μ) : Continuous fun φ : Lp ℂ 2 μ => (G • φ : Lp ℂ 2 μ) :=
  AddMonoidHomClass.continuous_of_bound
    (AddMonoidHom.mk' (fun φ : Lp ℂ 2 μ => (G • φ : Lp ℂ 2 μ)) (Lp.add_smul G)) ‖G‖
    fun φ => Lp.norm_smul_le G φ

variable [TopologicalSpace X] [CompactSpace X] [BorelSpace X] [IsFiniteMeasure μ]

/-- For continuous `g` and `f` on a compact space, the Hölder product of the `L^∞` class of `g`
with the `L²` class of `f` is the `L²` class of `g * f`. -/
theorem toLp_top_smul_toLp (g f : C(X, ℂ)) :
    (ContinuousMap.toLp ∞ μ ℂ g • ContinuousMap.toLp 2 μ ℂ f : Lp ℂ 2 μ) =
      ContinuousMap.toLp 2 μ ℂ (g * f) := by
  refine Lp.ext ?_
  filter_upwards
    [Lp.coeFn_lpSMul (r := 2) (ContinuousMap.toLp ∞ μ ℂ g) (ContinuousMap.toLp 2 μ ℂ f),
    ContinuousMap.coeFn_toLp (p := ∞) (𝕜 := ℂ) μ g,
    ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) μ f,
    ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) μ (g * f)] with x h1 h2 h3 h4
  rw [h1, h4, Pi.smul_apply', h2, h3, smul_eq_mul, ContinuousMap.mul_apply]

/-- For continuous `g` and `φ ∈ L²`, the function `x ↦ g x * φ x` is in `L²`. -/
theorem memLp_continuousMap_mul (g : C(X, ℂ)) (φ : Lp ℂ 2 μ) :
    MemLp (fun x => g x * φ x) 2 μ := by
  refine (Lp.memLp (ContinuousMap.toLp ∞ μ ℂ g • φ : Lp ℂ 2 μ)).ae_eq ?_
  filter_upwards [Lp.coeFn_lpSMul (r := 2) (ContinuousMap.toLp ∞ μ ℂ g) φ,
    ContinuousMap.coeFn_toLp (p := ∞) (𝕜 := ℂ) μ g] with x h1 h2
  rw [h1, Pi.smul_apply', h2, smul_eq_mul]

/-- The Hölder product of the `L^∞` class of a continuous `g` with `φ ∈ L²` is the `L²` class of
`x ↦ g x * φ x`. -/
theorem toLp_top_smul_eq_toLp (g : C(X, ℂ)) (φ : Lp ℂ 2 μ) :
    (ContinuousMap.toLp ∞ μ ℂ g • φ : Lp ℂ 2 μ) =
      (memLp_continuousMap_mul g φ).toLp (fun x => g x * φ x) := by
  refine Lp.ext ?_
  filter_upwards [Lp.coeFn_lpSMul (r := 2) (ContinuousMap.toLp ∞ μ ℂ g) φ,
    ContinuousMap.coeFn_toLp (p := ∞) (𝕜 := ℂ) μ g,
    (memLp_continuousMap_mul g φ).coeFn_toLp] with x h1 h2 h3
  rw [h1, h3, Pi.smul_apply', h2, smul_eq_mul]

end Multiplication

/-- **Intertwining** (Reed–Simon I, §VII.2, Lemma 1, p. 226): `U (g • φ) = g(T) (U φ)` for
continuous `g` and `φ ∈ L²(μ_ψ)`, where `g • φ` is the Hölder product of the `L^∞` class of `g`
with `φ`.  Equivalently `U⁻¹ g(T) U` is multiplication by `g` on `L²(σ(T), μ_ψ)`. -/
theorem cyclicIsometry_smul (ψ : H) (g : C(spectrum ℂ T, ℂ))
    (φ : Lp ℂ 2 (spectralMeasure T ψ)) :
    cyclicIsometry T ψ
        (ContinuousMap.toLp ∞ (spectralMeasure T ψ) ℂ g • φ : Lp ℂ 2 (spectralMeasure T ψ)) =
      cfcHom hT g (cyclicIsometry T ψ φ) := by
  refine (denseRange_toLp T ψ).induction_on φ
    (isClosed_eq ((cyclicIsometry T ψ).continuous.comp (continuous_lpSMul _))
      ((cfcHom hT g).continuous.comp (cyclicIsometry T ψ).continuous)) fun f => ?_
  rw [toLp_top_smul_toLp, cyclicIsometry_toLp, cyclicIsometry_toLp, map_mul, mul_apply_eq_comp]

/-- **Intertwining**, pointwise form: `U (g φ) = g(T) (U φ)`, where `g φ` is the `L²` class of
`x ↦ g x * φ x`. -/
theorem cyclicIsometry_mul (ψ : H) (g : C(spectrum ℂ T, ℂ)) (φ : Lp ℂ 2 (spectralMeasure T ψ)) :
    cyclicIsometry T ψ ((memLp_continuousMap_mul g φ).toLp (fun x => g x * φ x)) =
      cfcHom hT g (cyclicIsometry T ψ φ) := by
  rw [← toLp_top_smul_eq_toLp, cyclicIsometry_smul]

/-- **Reed–Simon I, §VII.2, Lemma 1** (p. 226): `U⁻¹ T U` is multiplication by the variable
`λ ↦ λ` on `L²(σ(T), μ_ψ)`. -/
theorem cyclicIsometry_mul_id (ψ : H) (φ : Lp ℂ 2 (spectralMeasure T ψ)) :
    cyclicIsometry T ψ ((memLp_continuousMap_mul ((ContinuousMap.id ℂ).restrict (spectrum ℂ T))
        φ).toLp (fun x => (x : ℂ) * φ x)) = T (cyclicIsometry T ψ φ) := by
  have h := cyclicIsometry_mul T ψ ((ContinuousMap.id ℂ).restrict (spectrum ℂ T)) φ
  rw [cfcHom_id] at h
  exact h

/-- **Reed–Simon I, §VII.2, Lemma 1** (p. 226) in their direction: the inverse unitary
`V : H_ψ → L²(σ(T), μ_ψ)` satisfies `V (g(T) x) = g • V x` for `x ∈ H_ψ` and continuous `g`. -/
theorem cyclicEquiv_symm_cfcHom (ψ : H) (g : C(spectrum ℂ T, ℂ)) (x : cyclicSubmodule T ψ) :
    (cyclicEquiv T ψ).symm ⟨cfcHom hT g x, mapsTo_cfcHom_cyclicSubmodule T ψ g x.2⟩ =
      (ContinuousMap.toLp ∞ (spectralMeasure T ψ) ℂ g • (cyclicEquiv T ψ).symm x :
        Lp ℂ 2 (spectralMeasure T ψ)) := by
  rw [LinearIsometryEquiv.symm_apply_eq]
  ext
  rw [coe_cyclicEquiv_apply, cyclicIsometry_smul, ← coe_cyclicEquiv_apply,
    LinearIsometryEquiv.apply_symm_apply]

/-! ### Invariant subspaces and orthogonality -/

/-- If a subspace `K` is invariant under every `g(T)`, so is its orthogonal complement `Kᗮ`,
because `g(T)† = (conj g)(T)` maps `K` into `K`. -/
theorem mapsTo_orthogonal {K : Submodule ℂ H}
    (hK : ∀ g : C(spectrum ℂ T, ℂ), Set.MapsTo (cfcHom hT g) (K : Set H) K)
    (g : C(spectrum ℂ T, ℂ)) : Set.MapsTo (cfcHom hT g) (Kᗮ : Set H) Kᗮ := by
  intro x hx
  rw [SetLike.mem_coe, Submodule.mem_orthogonal] at hx ⊢
  intro u hu
  rw [← ContinuousLinearMap.adjoint_inner_left, ← ContinuousLinearMap.star_eq_adjoint,
    ← map_star]
  exact hx _ (hK (star g) hu)

/-- A closed subspace invariant under every `g(T)` contains the cyclic subspace of each of its
vectors. -/
theorem cyclicSubmodule_le_of_mem {K : Submodule ℂ H} (hK : IsClosed (K : Set H))
    (hinv : ∀ g : C(spectrum ℂ T, ℂ), Set.MapsTo (cfcHom hT g) (K : Set H) K) {φ : H}
    (hφ : φ ∈ K) : cyclicSubmodule T φ ≤ K :=
  cyclicSubmodule_le T hK fun f => hinv f hφ

/-- If `φ ∈ H_ψ` then `H_φ ≤ H_ψ`. -/
theorem cyclicSubmodule_le_cyclicSubmodule {φ ψ : H} (h : φ ∈ cyclicSubmodule T ψ) :
    cyclicSubmodule T φ ≤ cyclicSubmodule T ψ :=
  cyclicSubmodule_le_of_mem T (isClosed_cyclicSubmodule T ψ)
    (mapsTo_cfcHom_cyclicSubmodule T ψ) h

/-- If `φ ⊥ H_ψ` then `H_φ ⊥ H_ψ`. -/
theorem cyclicSubmodule_isOrtho {φ ψ : H} (h : φ ∈ (cyclicSubmodule T ψ)ᗮ) :
    cyclicSubmodule T φ ⟂ cyclicSubmodule T ψ :=
  Submodule.isOrtho_iff_le.mpr <|
    cyclicSubmodule_le_of_mem T (Submodule.isClosed_orthogonal _)
      (mapsTo_orthogonal T (mapsTo_cfcHom_cyclicSubmodule T ψ)) h

end SpectralTheorem

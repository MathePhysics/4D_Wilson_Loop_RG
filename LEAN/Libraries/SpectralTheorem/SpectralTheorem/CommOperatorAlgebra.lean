import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Basic
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Instances
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Unique
import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
import Mathlib.Analysis.CStarAlgebra.GelfandDuality
import Mathlib.Analysis.Normed.Algebra.Basic
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.Topology.Metrizable.Basic

/-!
# Commutative C*-algebras of operators and their Gelfand representation

A closed commutative `⋆`-subalgebra `𝒜` of `𝓛(H)` containing `1` is a commutative unital
C*-algebra, so by the commutative Gelfand–Naimark theorem the Gelfand transform is an isometric
`⋆`-isomorphism of `𝒜` onto `C(Δ)`, `Δ` the Gelfand spectrum (character space) of `𝒜`, a compact
Hausdorff space.  Composed with the inclusion `𝒜 ⊆ 𝓛(H)`, its inverse is a representation
`π_𝒜 : C(Δ) → 𝓛(H)` whose range is `𝒜`.  This is the setting of the spectral theorem for
commutative C*-algebras of operators (Rudin, *Functional Analysis*, Chapter 12).  Reed–Simon I,
§VII.1, remarks (2)–(4) after Theorem VII.1, p. 224: for a bounded self-adjoint `A`, the range
of the continuous functional calculus `C(σ(A)) → 𝓛(H)` is an abelian C* algebra of operators,
the C*-algebra generated by `A`, and the isometric isomorphism of `C(σ(A))` with it is a special
case of the commutative Gelfand–Naimark theorem.

This module provides the algebraic and topological input for that theorem.

* `CommOperatorAlgebra H`: closed commutative `⋆`-subalgebras of `𝓛(H)`, with the
  `CommCStarAlgebra` structure obtained from mathlib's `StarSubalgebra.cstarAlgebra` and
  commutativity.
* The Borel `σ`-algebra on the character space (compact and Hausdorff by mathlib).
* The representation `gelfandRep 𝒜`, the inverse of mathlib's `gelfandStarTransform`, followed by
  the inclusion.
* Metrizability.  If `𝒜` is the closure of the `⋆`-algebra generated by a countable set `s`, the
  map `χ ↦ (χ a)_{a ∈ s}` is continuous (weak-* topology), injective (two characters are
  continuous `⋆`-homomorphisms, so they agree on the closed `⋆`-subalgebra where they agree, which
  contains `s`), and goes from a compact space to the metrizable space `s → ℂ`, so it is a closed
  embedding and `Δ` is metrizable.
* Commuting families.  For operators `T i` which commute with each other and with each other's
  adjoints, the closure of the `⋆`-algebra they generate is commutative: its elements commute with
  every `T j` and `T j†`, hence lie in the commutant of that commutant, and everything there
  commutes with the first commutant.  The joint evaluation `χ ↦ (χ (T i))_i` identifies `Δ` with a
  compact subset of `ℂ^ι`, the joint spectrum; for a single normal operator it is `σ(T)`.  The
  hypothesis that the `T i` commute with the adjoints `T j†` follows from `[T i, T j] = 0` for
  normal operators by Fuglede's theorem, which is not used here.

## Main definitions and results

* `SpectralTheorem.CommOperatorAlgebra H`: a closed commutative `⋆`-subalgebra of `𝓛(H)`, with
  the instance `CommCStarAlgebra 𝒜` and `spectrum_coe` (spectral permanence).
* `SpectralTheorem.CommOperatorAlgebra.instMeasurableSpace`, `instBorelSpace`: the Borel structure
  on `characterSpace ℂ 𝒜`.
* `SpectralTheorem.CommOperatorAlgebra.gelfandRep 𝒜 : C(characterSpace ℂ 𝒜, ℂ) →⋆ₐ[ℂ] 𝓛(H)`,
  with `gelfandRep_gelfandTransform`, `gelfandTransform_gelfandRep`, `gelfandRep_injective`,
  `norm_gelfandRep`, `range_gelfandRep`.
* `SpectralTheorem.CommOperatorAlgebra.characterSpace_ext_of_generators`: characters agreeing on
  a generating set are equal.
* `SpectralTheorem.CommOperatorAlgebra.evalOn`: the map `χ ↦ (χ a)_{a ∈ s}` for `s ⊆ 𝒜`;
  `continuous_evalOn`, `evalOn_injective`, `isClosedEmbedding_evalOn` for a generating set, and
  `metrizableSpace_of_countable`, `secondCountableTopology_of_countable` for a countable one.
* `SpectralTheorem.CommOperatorAlgebra.generated T hc hc'`: the closed `⋆`-algebra generated by a
  star-commuting family, with `mem_generated`, `generated_le`, `generated_le_of_isClosed`.
* `SpectralTheorem.CommOperatorAlgebra.jointEval`: the joint evaluation, with
  `continuous_jointEval`, `jointEval_injective`, `isClosedEmbedding_jointEval`,
  `gelfandTransform_eq_comp_jointEval`, and the instances `metrizableSpace_generated`,
  `secondCountableTopology_generated` for countable `ι`.
* `SpectralTheorem.CommOperatorAlgebra.jointSpectrum`: the joint spectrum, with
  `range_jointEval`, `isCompact_jointSpectrum`, `jointEvalHomeomorph` (Gelfand spectrum ≃ₜ joint
  spectrum), `image_eval_jointSpectrum` (its projections are the spectra `σ(T i)`), and
  `image_jointSpectrum_unit` (for `ι = Unit` it is `σ(T ())`).
* `SpectralTheorem.CommOperatorAlgebra.jointCalc`: the joint continuous functional calculus
  `C(jointSpectrum, ℂ) → 𝓛(H)`, with `jointCalc_coord` (coordinates go to the `T i`),
  `norm_jointCalc`, `jointCalc_injective`, `range_jointCalc`.
* `SpectralTheorem.CommOperatorAlgebra.ofNormal T`: the algebra generated by one normal operator,
  with `normalEvalHomeomorph : characterSpace ℂ (ofNormal T) ≃ₜ σ(T)` and
  `gelfandRep_comp_normalEvalHomeomorph`: the Gelfand representation is mathlib's continuous
  functional calculus `cfcHom`.
-/

noncomputable section

open WeakDual TopologicalSpace

namespace SpectralTheorem

universe u

/-- A **closed commutative `⋆`-subalgebra** of `𝓛(H)` (containing `1`, as every
`StarSubalgebra`). -/
structure CommOperatorAlgebra (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  /-- The underlying `⋆`-subalgebra. -/
  toStarSubalgebra : StarSubalgebra ℂ (H →L[ℂ] H)
  /-- The algebra is norm closed. -/
  isClosed : IsClosed (toStarSubalgebra : Set (H →L[ℂ] H))
  /-- Any two elements commute. -/
  mul_comm : ∀ a ∈ toStarSubalgebra, ∀ b ∈ toStarSubalgebra, a * b = b * a

namespace CommOperatorAlgebra

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

instance : SetLike (CommOperatorAlgebra H) (H →L[ℂ] H) where
  coe 𝒜 := 𝒜.toStarSubalgebra
  coe_injective p q h := by
    cases p; cases q
    congr
    exact SetLike.coe_injective h

/-- The inclusion order. -/
instance : PartialOrder (CommOperatorAlgebra H) :=
  .ofSetLike (CommOperatorAlgebra H) (H →L[ℂ] H)

instance : SubringClass (CommOperatorAlgebra H) (H →L[ℂ] H) where
  mul_mem {𝒜} := 𝒜.toStarSubalgebra.mul_mem
  one_mem 𝒜 := 𝒜.toStarSubalgebra.one_mem
  add_mem {𝒜} := 𝒜.toStarSubalgebra.add_mem
  zero_mem 𝒜 := 𝒜.toStarSubalgebra.zero_mem
  neg_mem {𝒜} := 𝒜.toStarSubalgebra.neg_mem

instance : SMulMemClass (CommOperatorAlgebra H) ℂ (H →L[ℂ] H) where
  smul_mem {𝒜} c _ h := 𝒜.toStarSubalgebra.smul_mem h c

instance : StarMemClass (CommOperatorAlgebra H) (H →L[ℂ] H) where
  star_mem {𝒜} _ h := 𝒜.toStarSubalgebra.star_mem' h

variable (𝒜 : CommOperatorAlgebra H)

/-- Membership in `𝒜` is membership in its underlying `⋆`-subalgebra. -/
@[simp]
theorem mem_toStarSubalgebra {a : H →L[ℂ] H} : a ∈ 𝒜.toStarSubalgebra ↔ a ∈ 𝒜 :=
  Iff.rfl

/-- The underlying set of `𝒜` is that of its underlying `⋆`-subalgebra. -/
@[simp]
theorem coe_toStarSubalgebra : (𝒜.toStarSubalgebra : Set (H →L[ℂ] H)) = 𝒜 :=
  rfl

/-- Two closed commutative `⋆`-subalgebras with the same elements are equal. -/
@[ext]
theorem ext {𝒜 𝒝 : CommOperatorAlgebra H} (h : ∀ a, a ∈ 𝒜 ↔ a ∈ 𝒝) : 𝒜 = 𝒝 :=
  SetLike.ext h

/-- `𝒜` is closed in `𝓛(H)`. -/
instance isClosed_coe : IsClosed (𝒜 : Set (H →L[ℂ] H)) :=
  𝒜.isClosed

/-- `𝒜`, as a type, is commutative. -/
instance : IsMulCommutative 𝒜 :=
  ⟨⟨fun a b => Subtype.ext (𝒜.mul_comm a a.2 b b.2)⟩⟩

/-- `𝒜` is a C*-algebra: a closed `⋆`-subalgebra of the C*-algebra `𝓛(H)`. -/
instance instCStarAlgebra : CStarAlgebra 𝒜 :=
  StarSubalgebra.cstarAlgebra 𝒜

open scoped IsMulCommutative in
/-- `𝒜` is a commutative C*-algebra. -/
instance instCommCStarAlgebra : CommCStarAlgebra 𝒜 where

/-- The inclusion of `𝒜` in `𝓛(H)` as a `⋆`-algebra homomorphism. -/
def subtype : 𝒜 →⋆ₐ[ℂ] (H →L[ℂ] H) where
  toFun := Subtype.val
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl
  map_star' _ := rfl

/-- The inclusion is the coercion. -/
@[simp]
theorem subtype_apply (a : 𝒜) : 𝒜.subtype a = a :=
  rfl

/-- The norm of an element of `𝒜` is its operator norm. -/
theorem norm_coe (a : 𝒜) : ‖(a : H →L[ℂ] H)‖ = ‖a‖ :=
  rfl

/-! ### The Borel structure on the Gelfand spectrum -/

/-- The Borel `σ`-algebra on the Gelfand spectrum `characterSpace ℂ 𝒜`. -/
instance instMeasurableSpace : MeasurableSpace (characterSpace ℂ 𝒜) :=
  borel _

/-- The Gelfand spectrum with its Borel `σ`-algebra is a Borel space. -/
instance instBorelSpace : BorelSpace (characterSpace ℂ 𝒜) :=
  ⟨rfl⟩

/-- The Gelfand spectrum is compact (mathlib). -/
example : CompactSpace (characterSpace ℂ 𝒜) := inferInstance

/-- The Gelfand spectrum is Hausdorff (mathlib). -/
example : T2Space (characterSpace ℂ 𝒜) := inferInstance

/-! ### The Gelfand representation -/

/-- **The Gelfand representation** `π_𝒜 : C(Δ) → 𝓛(H)` of `𝒜`: the inverse of the Gelfand
transform `𝒜 ≃ C(Δ)` followed by the inclusion `𝒜 ⊆ 𝓛(H)`. -/
def gelfandRep : C(characterSpace ℂ 𝒜, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H) :=
  𝒜.subtype.comp (gelfandStarTransform 𝒜).symm.toStarAlgHom

/-- `π_𝒜 f` is the element of `𝒜` whose Gelfand transform is `f`. -/
theorem gelfandRep_apply (f : C(characterSpace ℂ 𝒜, ℂ)) :
    gelfandRep 𝒜 f = ((gelfandStarTransform 𝒜).symm f : H →L[ℂ] H) :=
  rfl

/-- `π_𝒜 f ∈ 𝒜`. -/
theorem gelfandRep_mem (f : C(characterSpace ℂ 𝒜, ℂ)) : gelfandRep 𝒜 f ∈ 𝒜 :=
  ((gelfandStarTransform 𝒜).symm f).2

/-- **`π_𝒜` inverts the Gelfand transform**: `π_𝒜 (â) = a` for `a ∈ 𝒜`. -/
@[simp]
theorem gelfandRep_gelfandTransform (a : 𝒜) :
    gelfandRep 𝒜 (gelfandTransform ℂ 𝒜 a) = a := by
  have h : gelfandTransform ℂ 𝒜 a = gelfandStarTransform 𝒜 a := rfl
  rw [gelfandRep_apply, h, StarAlgEquiv.symm_apply_apply]

/-- The Gelfand transform of `π_𝒜 f` is `f`. -/
@[simp]
theorem gelfandTransform_gelfandRep (f : C(characterSpace ℂ 𝒜, ℂ)) :
    gelfandTransform ℂ 𝒜 ⟨gelfandRep 𝒜 f, gelfandRep_mem 𝒜 f⟩ = f := by
  have h : gelfandTransform ℂ 𝒜 ⟨gelfandRep 𝒜 f, gelfandRep_mem 𝒜 f⟩ =
      gelfandStarTransform 𝒜 ((gelfandStarTransform 𝒜).symm f) := rfl
  rw [h, StarAlgEquiv.apply_symm_apply]

/-- **`π_𝒜` is isometric**: `‖π_𝒜 f‖ = ‖f‖_∞`. -/
@[simp]
theorem norm_gelfandRep (f : C(characterSpace ℂ 𝒜, ℂ)) : ‖gelfandRep 𝒜 f‖ = ‖f‖ := by
  obtain ⟨a, rfl⟩ : ∃ a, gelfandTransform ℂ 𝒜 a = f := (gelfandTransform_bijective 𝒜).2 f
  rw [gelfandRep_gelfandTransform, norm_coe]
  exact ((gelfandTransform_isometry 𝒜).norm_map_of_map_zero (map_zero _) a).symm

/-- `π_𝒜` is an isometry. -/
theorem isometry_gelfandRep : Isometry (gelfandRep 𝒜) :=
  AddMonoidHomClass.isometry_of_norm (gelfandRep 𝒜) (norm_gelfandRep 𝒜)

/-- **`π_𝒜` is injective.** -/
theorem gelfandRep_injective : Function.Injective (gelfandRep 𝒜) :=
  (isometry_gelfandRep 𝒜).injective

/-- `π_𝒜` is continuous. -/
theorem continuous_gelfandRep : Continuous (gelfandRep 𝒜) :=
  (isometry_gelfandRep 𝒜).continuous

/-- **The range of `π_𝒜` is `𝒜`.** -/
theorem range_gelfandRep : (gelfandRep 𝒜).range = 𝒜.toStarSubalgebra := by
  ext a
  refine ⟨?_, fun ha => ?_⟩
  · rintro ⟨f, rfl⟩
    exact gelfandRep_mem 𝒜 f
  · exact ⟨gelfandTransform ℂ 𝒜 ⟨a, ha⟩, gelfandRep_gelfandTransform 𝒜 ⟨a, ha⟩⟩

/-- The range of `π_𝒜` is `𝒜`, as sets. -/
theorem coe_range_gelfandRep : Set.range (gelfandRep 𝒜) = 𝒜 := by
  ext a
  refine ⟨?_, fun ha => ?_⟩
  · rintro ⟨f, rfl⟩
    exact gelfandRep_mem 𝒜 f
  · exact ⟨gelfandTransform ℂ 𝒜 ⟨a, ha⟩, gelfandRep_gelfandTransform 𝒜 ⟨a, ha⟩⟩

/-! ### Generating sets and metrizability of the Gelfand spectrum -/

variable {𝒜}

/-- If `𝒜` is the closure of the `⋆`-algebra generated by `s`, then `s ⊆ 𝒜`. -/
theorem mem_of_mem_generators {s : Set (H →L[ℂ] H)}
    (h : 𝒜.toStarSubalgebra = (StarAlgebra.adjoin ℂ s).topologicalClosure)
    {a : H →L[ℂ] H} (ha : a ∈ s) : a ∈ 𝒜 := by
  rw [← mem_toStarSubalgebra, h]
  exact StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ s ha)

/-- Two continuous `⋆`-homomorphisms `𝒜 → ℂ` which agree on a generating set `s` are equal:
they agree on the closed `⋆`-subalgebra where they agree, which contains `s`. -/
theorem starAlgHom_ext_of_generators {s : Set (H →L[ℂ] H)}
    (h : 𝒜.toStarSubalgebra = (StarAlgebra.adjoin ℂ s).topologicalClosure)
    {φ ψ : 𝒜 →⋆ₐ[ℂ] ℂ} (hφ : Continuous φ) (hψ : Continuous ψ)
    (hs : ∀ (a : H →L[ℂ] H) (ha : a ∈ s),
      φ ⟨a, mem_of_mem_generators h ha⟩ = ψ ⟨a, mem_of_mem_generators h ha⟩) :
    φ = ψ := by
  set E : StarSubalgebra ℂ (H →L[ℂ] H) := (StarAlgHom.equalizer φ ψ).map 𝒜.subtype with hE_def
  have hE : IsClosed (E : Set (H →L[ℂ] H)) := by
    rw [hE_def, StarSubalgebra.coe_map]
    exact 𝒜.isClosed.isClosedMap_subtype_val _ (isClosed_eq hφ hψ)
  have hsE : s ⊆ E := fun a ha => ⟨⟨a, mem_of_mem_generators h ha⟩, hs a ha, rfl⟩
  have hle : (StarAlgebra.adjoin ℂ s).topologicalClosure ≤ E :=
    StarSubalgebra.topologicalClosure_minimal (StarAlgebra.adjoin_le hsE) hE
  ext x
  have hx : (x : H →L[ℂ] H) ∈ (StarAlgebra.adjoin ℂ s).topologicalClosure := by
    rw [← h]
    exact x.2
  obtain ⟨y, hy, hyx⟩ := hle hx
  have hyx' : y = x := Subtype.ext hyx
  rw [← hyx']
  exact hy

/-- **Characters are determined by their values on generators**: if `𝒜` is the closure of the
`⋆`-algebra generated by `s`, two characters of `𝒜` which agree on `s` are equal. -/
theorem characterSpace_ext_of_generators {s : Set (H →L[ℂ] H)}
    (h : 𝒜.toStarSubalgebra = (StarAlgebra.adjoin ℂ s).topologicalClosure)
    {χ₁ χ₂ : characterSpace ℂ 𝒜}
    (hs : ∀ (a : H →L[ℂ] H) (ha : a ∈ s),
      χ₁ ⟨a, mem_of_mem_generators h ha⟩ = χ₂ ⟨a, mem_of_mem_generators h ha⟩) :
    χ₁ = χ₂ := by
  have key : StarAlgHom.ofClass χ₁ = StarAlgHom.ofClass χ₂ :=
    starAlgHom_ext_of_generators h (map_continuous χ₁) (map_continuous χ₂) hs
  exact CharacterSpace.ext fun x => DFunLike.congr_fun key x

variable (𝒜)

/-- The evaluation of characters on a subset `s ⊆ 𝒜`: `χ ↦ (χ a)_{a ∈ s}`. -/
def evalOn (s : Set (H →L[ℂ] H)) (hs : s ⊆ 𝒜) : characterSpace ℂ 𝒜 → (s → ℂ) :=
  fun χ a => χ ⟨a, hs a.2⟩

/-- `evalOn` is evaluation. -/
@[simp]
theorem evalOn_apply (s : Set (H →L[ℂ] H)) (hs : s ⊆ 𝒜) (χ : characterSpace ℂ 𝒜) (a : s) :
    evalOn 𝒜 s hs χ a = χ ⟨a, hs a.2⟩ :=
  rfl

/-- `χ ↦ (χ a)_{a ∈ s}` is continuous for the weak-* topology. -/
theorem continuous_evalOn (s : Set (H →L[ℂ] H)) (hs : s ⊆ 𝒜) : Continuous (evalOn 𝒜 s hs) :=
  continuous_pi fun a => (gelfandTransform ℂ 𝒜 ⟨a, hs a.2⟩).continuous

variable {𝒜}

/-- If `𝒜` is the closure of the `⋆`-algebra generated by `s`, then `χ ↦ (χ a)_{a ∈ s}` is
injective. -/
theorem evalOn_injective {s : Set (H →L[ℂ] H)}
    (h : 𝒜.toStarSubalgebra = (StarAlgebra.adjoin ℂ s).topologicalClosure) :
    Function.Injective (evalOn 𝒜 s fun _ ha => mem_of_mem_generators h ha) := by
  intro χ₁ χ₂ h12
  exact characterSpace_ext_of_generators h fun a ha => congr_fun h12 ⟨a, ha⟩

/-- `χ ↦ (χ a)_{a ∈ s}` is a closed embedding of the Gelfand spectrum into `s → ℂ`, if `𝒜` is
the closure of the `⋆`-algebra generated by `s`. -/
theorem isClosedEmbedding_evalOn {s : Set (H →L[ℂ] H)}
    (h : 𝒜.toStarSubalgebra = (StarAlgebra.adjoin ℂ s).topologicalClosure) :
    Topology.IsClosedEmbedding (evalOn 𝒜 s fun _ ha => mem_of_mem_generators h ha) :=
  (continuous_evalOn 𝒜 s _).isClosedEmbedding (evalOn_injective h)

/-- **Metrizability of the Gelfand spectrum.** If `𝒜` is the closure of the `⋆`-algebra
generated by a countable set `s`, then its Gelfand spectrum is metrizable. -/
theorem metrizableSpace_of_countable {s : Set (H →L[ℂ] H)} (hc : s.Countable)
    (h : 𝒜.toStarSubalgebra = (StarAlgebra.adjoin ℂ s).topologicalClosure) :
    MetrizableSpace (characterSpace ℂ 𝒜) :=
  have : Countable s := hc.to_subtype
  (isClosedEmbedding_evalOn h).isEmbedding.metrizableSpace

/-- If `𝒜` is the closure of the `⋆`-algebra generated by a countable set `s`, then its Gelfand
spectrum is second countable. -/
theorem secondCountableTopology_of_countable {s : Set (H →L[ℂ] H)} (hc : s.Countable)
    (h : 𝒜.toStarSubalgebra = (StarAlgebra.adjoin ℂ s).topologicalClosure) :
    SecondCountableTopology (characterSpace ℂ 𝒜) :=
  have : Countable s := hc.to_subtype
  (isClosedEmbedding_evalOn h).isEmbedding.secondCountableTopology

variable (𝒜)

/-- **Spectral permanence** for `𝒜`: the spectrum of `a ∈ 𝒜` in `𝒜` is its spectrum in
`𝓛(H)`. -/
theorem spectrum_coe (a : 𝒜) : spectrum ℂ (a : H →L[ℂ] H) = spectrum ℂ a :=
  (StarSubalgebra.spectrum_eq 𝒜.toStarSubalgebra (hS := 𝒜.isClosed) (a := a)).symm

/-! ### The closed `⋆`-algebra generated by a star-commuting family -/

variable {𝒜}

/-- If the elements of `s` commute with each other and with each other's adjoints, then the
closed `⋆`-algebra generated by `s` lies in the commutant of `s ∪ s⋆`. -/
theorem topologicalClosure_adjoin_le_centralizer {s : Set (H →L[ℂ] H)}
    (hs : ∀ a ∈ s, ∀ b ∈ s, Commute a b ∧ Commute a (star b)) :
    (StarAlgebra.adjoin ℂ s).topologicalClosure ≤ StarSubalgebra.centralizer ℂ s := by
  refine StarSubalgebra.topologicalClosure_minimal (StarAlgebra.adjoin_le fun a ha => ?_) ?_
  · rw [SetLike.mem_coe, StarSubalgebra.mem_centralizer_iff]
    intro g hg
    exact ⟨(hs a ha g hg).1.eq.symm, (hs a ha g hg).2.eq.symm⟩
  · exact Set.isClosed_centralizer _

/-- If the elements of `s` commute with each other and with each other's adjoints, then the
closed `⋆`-algebra generated by `s` is commutative: its elements lie in the commutant of `s ∪ s⋆`
and in the commutant of that commutant. -/
theorem mul_comm_of_mem_topologicalClosure_adjoin {s : Set (H →L[ℂ] H)}
    (hs : ∀ a ∈ s, ∀ b ∈ s, Commute a b ∧ Commute a (star b)) {a b : H →L[ℂ] H}
    (ha : a ∈ (StarAlgebra.adjoin ℂ s).topologicalClosure)
    (hb : b ∈ (StarAlgebra.adjoin ℂ s).topologicalClosure) : a * b = b * a := by
  have ha' := topologicalClosure_adjoin_le_centralizer hs ha
  have hb' := StarSubalgebra.topologicalClosure_adjoin_le_centralizer_centralizer ℂ s hb
  rw [StarSubalgebra.mem_centralizer_iff] at hb'
  exact (hb' a ha').1

section Generated

variable {ι : Type*} (T : ι → H →L[ℂ] H) (hc : ∀ i j, Commute (T i) (T j))
  (hc' : ∀ i j, Commute (T i) (star (T j)))

include hc hc' in
/-- The range of a star-commuting family is a star-commuting set. -/
theorem starCommute_range :
    ∀ a ∈ Set.range T, ∀ b ∈ Set.range T, Commute a b ∧ Commute a (star b) := by
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
  exact ⟨hc i j, hc' i j⟩

/-- **The closed `⋆`-algebra generated by a star-commuting family** `(T i)_{i ∈ ι}`: the closure
of the `⋆`-algebra generated by the `T i`.  It is commutative because the `T i` commute with each
other and with each other's adjoints. -/
def generated : CommOperatorAlgebra H where
  toStarSubalgebra := (StarAlgebra.adjoin ℂ (Set.range T)).topologicalClosure
  isClosed := StarSubalgebra.isClosed_topologicalClosure _
  mul_comm _ ha _ hb :=
    mul_comm_of_mem_topologicalClosure_adjoin (starCommute_range T hc hc') ha hb

/-- The underlying `⋆`-subalgebra of `generated T hc hc'`. -/
theorem generated_toStarSubalgebra :
    (generated T hc hc').toStarSubalgebra =
      (StarAlgebra.adjoin ℂ (Set.range T)).topologicalClosure :=
  rfl

/-- `T i ∈ generated T hc hc'`. -/
theorem mem_generated (i : ι) : T i ∈ generated T hc hc' :=
  mem_of_mem_generators (generated_toStarSubalgebra T hc hc') ⟨i, rfl⟩

/-- **Minimality**: `generated T hc hc'` lies in every closed `⋆`-subalgebra containing all the
`T i`. -/
theorem generated_le_of_isClosed {S : StarSubalgebra ℂ (H →L[ℂ] H)}
    (hS : IsClosed (S : Set (H →L[ℂ] H))) (hT : ∀ i, T i ∈ S) :
    (generated T hc hc').toStarSubalgebra ≤ S :=
  StarSubalgebra.topologicalClosure_minimal
    (StarAlgebra.adjoin_le (Set.range_subset_iff.2 hT)) hS

/-- **Minimality**: `generated T hc hc'` is the smallest closed commutative `⋆`-subalgebra
containing all the `T i`. -/
theorem generated_le {𝒝 : CommOperatorAlgebra H} (hT : ∀ i, T i ∈ 𝒝) : generated T hc hc' ≤ 𝒝 :=
  SetLike.le_def.2 fun _ ha => generated_le_of_isClosed T hc hc' 𝒝.isClosed hT ha

/-- **The joint evaluation** `χ ↦ (χ (T i))_{i ∈ ι}` on the Gelfand spectrum of
`generated T hc hc'`. -/
def jointEval : characterSpace ℂ (generated T hc hc') → (ι → ℂ) :=
  fun χ i => χ ⟨T i, mem_generated T hc hc' i⟩

/-- `jointEval` is evaluation at the `T i`. -/
@[simp]
theorem jointEval_apply (χ : characterSpace ℂ (generated T hc hc')) (i : ι) :
    jointEval T hc hc' χ i = χ ⟨T i, mem_generated T hc hc' i⟩ :=
  rfl

/-- The joint evaluation is continuous. -/
theorem continuous_jointEval : Continuous (jointEval T hc hc') :=
  continuous_pi fun i =>
    (gelfandTransform ℂ (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩).continuous

/-- **The joint evaluation is injective**: characters are determined by their values on the
generators. -/
theorem jointEval_injective : Function.Injective (jointEval T hc hc') := by
  intro χ₁ χ₂ h
  refine characterSpace_ext_of_generators (generated_toStarSubalgebra T hc hc') ?_
  rintro _ ⟨i, rfl⟩
  exact congr_fun h i

/-- The joint evaluation is a closed embedding of the Gelfand spectrum into `ℂ^ι`. -/
theorem isClosedEmbedding_jointEval : Topology.IsClosedEmbedding (jointEval T hc hc') :=
  (continuous_jointEval T hc hc').isClosedEmbedding (jointEval_injective T hc hc')

/-- **The Gelfand transform of a generator** is a coordinate of the joint evaluation:
`T̂ i = (z ↦ z i) ∘ jointEval`. -/
theorem gelfandTransform_eq_comp_jointEval (i : ι) :
    ⇑(gelfandTransform ℂ (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩) =
      (fun z => z i) ∘ jointEval T hc hc' :=
  rfl

/-- The Gelfand representation of `generated T hc hc'` sends the `i`-th coordinate of the joint
evaluation to `T i`. -/
theorem gelfandRep_coord (i : ι) :
    gelfandRep (generated T hc hc')
      ⟨fun χ => jointEval T hc hc' χ i, (continuous_apply i).comp (continuous_jointEval T hc hc')⟩
      = T i :=
  gelfandRep_gelfandTransform (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩

/-- **Metrizability**: for a countable star-commuting family, the Gelfand spectrum of the
generated algebra is metrizable (it embeds in `ℂ^ι`). -/
instance metrizableSpace_generated [Countable ι] :
    MetrizableSpace (characterSpace ℂ (generated T hc hc')) :=
  (isClosedEmbedding_jointEval T hc hc').isEmbedding.metrizableSpace

/-- For a countable star-commuting family, the Gelfand spectrum of the generated algebra is second
countable. -/
instance secondCountableTopology_generated [Countable ι] :
    SecondCountableTopology (characterSpace ℂ (generated T hc hc')) :=
  (isClosedEmbedding_jointEval T hc hc').isEmbedding.secondCountableTopology

/-! ### The joint spectrum -/

/-- **The joint spectrum** of a star-commuting family `(T i)_{i ∈ ι}`: the set of `z ∈ ℂ^ι` with
`z i = χ (T i)` for all `i`, for some character `χ` of the generated algebra. -/
def jointSpectrum : Set (ι → ℂ) :=
  {z | ∃ χ : characterSpace ℂ (generated T hc hc'),
    ∀ i, χ ⟨T i, mem_generated T hc hc' i⟩ = z i}

/-- The joint spectrum is the range of the joint evaluation. -/
theorem range_jointEval : Set.range (jointEval T hc hc') = jointSpectrum T hc hc' := by
  ext z
  constructor
  · rintro ⟨χ, rfl⟩
    exact ⟨χ, fun _ => rfl⟩
  · rintro ⟨χ, hχ⟩
    exact ⟨χ, funext hχ⟩

/-- **The joint spectrum is compact.** -/
theorem isCompact_jointSpectrum : IsCompact (jointSpectrum T hc hc') := by
  rw [← range_jointEval]
  exact isCompact_range (continuous_jointEval T hc hc')

/-- The joint spectrum is a compact space. -/
instance compactSpace_jointSpectrum : CompactSpace (jointSpectrum T hc hc') :=
  isCompact_iff_compactSpace.mp (isCompact_jointSpectrum T hc hc')

/-- The Gelfand spectrum of the generated algebra is homeomorphic to the joint spectrum, through
the joint evaluation. -/
def jointEvalHomeomorph : characterSpace ℂ (generated T hc hc') ≃ₜ jointSpectrum T hc hc' :=
  (isClosedEmbedding_jointEval T hc hc').isEmbedding.toHomeomorph.trans
    (Homeomorph.setCongr (range_jointEval T hc hc'))

/-- `jointEvalHomeomorph` is the joint evaluation. -/
@[simp]
theorem coe_jointEvalHomeomorph_apply (χ : characterSpace ℂ (generated T hc hc')) :
    (jointEvalHomeomorph T hc hc' χ : ι → ℂ) = jointEval T hc hc' χ :=
  rfl

/-- **The coordinate projections of the joint spectrum are the spectra**: the image of the joint
spectrum under `z ↦ z i` is `σ(T i)`. -/
theorem image_eval_jointSpectrum (i : ι) :
    (fun z : ι → ℂ => z i) '' jointSpectrum T hc hc' = spectrum ℂ (T i) := by
  ext w
  rw [← range_jointEval, ← Set.range_comp]
  change _ ↔
    w ∈ spectrum ℂ ((⟨T i, mem_generated T hc hc' i⟩ : generated T hc hc') : H →L[ℂ] H)
  rw [spectrum_coe, CharacterSpace.mem_spectrum_iff_exists]
  rfl

/-- The joint spectrum lies in the product of the spectra `∏ σ(T i)`. -/
theorem jointSpectrum_subset_pi :
    jointSpectrum T hc hc' ⊆ Set.univ.pi fun i => spectrum ℂ (T i) := by
  intro z hz i _
  change z i ∈ spectrum ℂ (T i)
  rw [← image_eval_jointSpectrum T hc hc' i]
  exact ⟨z, hz, rfl⟩

/-- **The joint continuous functional calculus** of a star-commuting family: `g ↦ g(T)` for `g`
continuous on the joint spectrum, defined as `π (g ∘ jointEval)` with `π` the Gelfand
representation of the generated algebra. -/
def jointCalc : C(jointSpectrum T hc hc', ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H) :=
  (gelfandRep (generated T hc hc')).comp
    (ContinuousMap.compStarAlgHom' ℂ ℂ
      (jointEvalHomeomorph T hc hc' :
        C(characterSpace ℂ (generated T hc hc'), jointSpectrum T hc hc')))

/-- `g(T) = π (g ∘ jointEval)`. -/
theorem jointCalc_apply (g : C(jointSpectrum T hc hc', ℂ)) :
    jointCalc T hc hc' g =
      gelfandRep (generated T hc hc')
        (g.comp (jointEvalHomeomorph T hc hc' :
          C(characterSpace ℂ (generated T hc hc'), jointSpectrum T hc hc'))) :=
  rfl

/-- **The joint functional calculus sends the `i`-th coordinate to `T i`.** -/
theorem jointCalc_coord (i : ι) :
    jointCalc T hc hc'
      ⟨fun z => (z : ι → ℂ) i, (continuous_apply i).comp continuous_subtype_val⟩ = T i :=
  gelfandRep_gelfandTransform (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩

/-- The joint functional calculus takes values in the generated algebra. -/
theorem jointCalc_mem (g : C(jointSpectrum T hc hc', ℂ)) :
    jointCalc T hc hc' g ∈ generated T hc hc' :=
  gelfandRep_mem _ _

/-- The joint functional calculus is injective. -/
theorem jointCalc_injective : Function.Injective (jointCalc T hc hc') := by
  intro g₁ g₂ h
  have h' := gelfandRep_injective (generated T hc hc') h
  ext z
  obtain ⟨χ, rfl⟩ := (jointEvalHomeomorph T hc hc').surjective z
  exact DFunLike.congr_fun h' χ

/-- The joint functional calculus is continuous. -/
theorem continuous_jointCalc : Continuous (jointCalc T hc hc') :=
  (continuous_gelfandRep _).comp (ContinuousMap.continuous_precomp _)

/-- **The joint functional calculus is isometric**: `‖g(T)‖ = ‖g‖_∞`. -/
theorem norm_jointCalc (g : C(jointSpectrum T hc hc', ℂ)) : ‖jointCalc T hc hc' g‖ = ‖g‖ := by
  rw [jointCalc_apply, norm_gelfandRep]
  set e := jointEvalHomeomorph T hc hc'
  refine le_antisymm ((ContinuousMap.norm_le _ (norm_nonneg g)).2 fun χ =>
    g.norm_coe_le_norm (e χ)) ((ContinuousMap.norm_le _ (norm_nonneg _)).2 fun z => ?_)
  obtain ⟨χ, rfl⟩ := e.surjective z
  exact (g.comp (e : C(characterSpace ℂ (generated T hc hc'), jointSpectrum T hc hc'))
    ).norm_coe_le_norm χ

/-- **The range of the joint functional calculus is the generated algebra.** -/
theorem range_jointCalc : Set.range (jointCalc T hc hc') = generated T hc hc' := by
  ext a
  refine ⟨?_, fun ha => ?_⟩
  · rintro ⟨g, rfl⟩
    exact jointCalc_mem T hc hc' g
  · set e := jointEvalHomeomorph T hc hc'
    set f := gelfandTransform ℂ (generated T hc hc') ⟨a, ha⟩
    refine ⟨f.comp (e.symm : C(jointSpectrum T hc hc', characterSpace ℂ (generated T hc hc'))),
      ?_⟩
    have hf : (f.comp (e.symm : C(jointSpectrum T hc hc', characterSpace ℂ _))).comp
        (e : C(characterSpace ℂ (generated T hc hc'), jointSpectrum T hc hc')) = f := by
      ext χ
      simp
    rw [jointCalc_apply, hf, gelfandRep_gelfandTransform]

end Generated

/-! ### One normal operator -/

section Normal

variable (T : H →L[ℂ] H) [hT : IsStarNormal T]

/-- **The closed `⋆`-algebra generated by a normal operator** `T`: the case `ι = Unit` of
`generated`. -/
def ofNormal : CommOperatorAlgebra H :=
  generated (fun _ : Unit => T) (fun _ _ => Commute.refl T)
    (fun _ _ => (IsStarNormal.star_comm_self (x := T)).symm)

/-- `T` belongs to the algebra it generates. -/
theorem self_mem_ofNormal : T ∈ ofNormal T :=
  mem_generated _ _ _ ()

/-- **Minimality**: `ofNormal T` lies in every closed commutative `⋆`-subalgebra containing
`T`. -/
theorem ofNormal_le {𝒝 : CommOperatorAlgebra H} (hT : T ∈ 𝒝) : ofNormal T ≤ 𝒝 :=
  generated_le _ _ _ fun _ => hT

/-- For `ι = Unit`, the joint spectrum is the spectrum: `{z () | z ∈ jointSpectrum} = σ(T ())`. -/
theorem image_jointSpectrum_unit (T : Unit → H →L[ℂ] H) (hc : ∀ i j, Commute (T i) (T j))
    (hc' : ∀ i j, Commute (T i) (star (T j))) :
    (fun z : Unit → ℂ => z ()) '' jointSpectrum T hc hc' = spectrum ℂ (T ()) :=
  image_eval_jointSpectrum T hc hc' ()

/-- The evaluation `χ ↦ χ(T)` from the Gelfand spectrum of `ofNormal T` to `σ(T)`. -/
def normalEval (χ : characterSpace ℂ (ofNormal T)) : spectrum ℂ T :=
  ⟨χ ⟨T, self_mem_ofNormal T⟩, (Set.ext_iff.1 (spectrum_coe (ofNormal T)
    ⟨T, self_mem_ofNormal T⟩) _).2 (CharacterSpace.apply_mem_spectrum χ _)⟩

/-- `normalEval` is evaluation at `T`. -/
@[simp]
theorem coe_normalEval (χ : characterSpace ℂ (ofNormal T)) :
    (normalEval T χ : ℂ) = χ ⟨T, self_mem_ofNormal T⟩ :=
  rfl

/-- `χ ↦ χ(T)` is continuous. -/
theorem continuous_normalEval : Continuous (normalEval T) :=
  continuous_induced_rng.2
    (gelfandTransform ℂ (ofNormal T) ⟨T, self_mem_ofNormal T⟩).continuous

/-- `χ ↦ χ(T)` is bijective onto `σ(T)`. -/
theorem bijective_normalEval : Function.Bijective (normalEval T) := by
  refine ⟨fun χ₁ χ₂ h => jointEval_injective _ _ _ (funext fun _ => ?_), ?_⟩
  · exact congrArg Subtype.val h
  · rintro ⟨z, hz⟩
    have hz' := (Set.ext_iff.1 (spectrum_coe (ofNormal T) ⟨T, self_mem_ofNormal T⟩) z).1 hz
    rw [CharacterSpace.mem_spectrum_iff_exists] at hz'
    obtain ⟨χ, rfl⟩ := hz'
    exact ⟨χ, rfl⟩

/-- **The Gelfand spectrum of the algebra generated by a normal operator is its spectrum**:
`χ ↦ χ(T)` is a homeomorphism `characterSpace ℂ (ofNormal T) ≃ₜ σ(T)`. -/
def normalEvalHomeomorph : characterSpace ℂ (ofNormal T) ≃ₜ spectrum ℂ T :=
  (continuous_normalEval T).homeoOfEquivCompactToT2
    (f := Equiv.ofBijective (normalEval T) (bijective_normalEval T))

/-- `normalEvalHomeomorph` is evaluation at `T`. -/
@[simp]
theorem normalEvalHomeomorph_apply (χ : characterSpace ℂ (ofNormal T)) :
    normalEvalHomeomorph T χ = normalEval T χ :=
  rfl

/-- The Gelfand spectrum of the algebra generated by a normal operator is metrizable. -/
instance metrizableSpace_ofNormal :
    MetrizableSpace (characterSpace ℂ (ofNormal T)) :=
  metrizableSpace_generated _ _ _

/-- The Gelfand spectrum of the algebra generated by a normal operator is second countable. -/
instance secondCountableTopology_ofNormal :
    SecondCountableTopology (characterSpace ℂ (ofNormal T)) :=
  secondCountableTopology_generated _ _ _

/-- `χ ↦ χ(T)` as a measurable equivalence of the Gelfand spectrum of `ofNormal T` (with its Borel
`σ`-algebra) with `σ(T)`. -/
def normalEvalMeasurableEquiv : characterSpace ℂ (ofNormal T) ≃ᵐ spectrum ℂ T :=
  (normalEvalHomeomorph T).toMeasurableEquiv

/-- **The Gelfand representation of `ofNormal T` is the continuous functional calculus**:
`π (g ∘ ev_T) = g(T)` for `g ∈ C(σ(T))`, where `ev_T χ = χ(T)`.  Both sides are continuous
`⋆`-homomorphisms of `C(σ(T))` sending the identity to `T`. -/
theorem gelfandRep_comp_normalEvalHomeomorph (g : C(spectrum ℂ T, ℂ)) :
    gelfandRep (ofNormal T)
        (g.comp (normalEvalHomeomorph T : C(characterSpace ℂ (ofNormal T), spectrum ℂ T))) =
      cfcHom hT g := by
  let φ : C(spectrum ℂ T, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H) := (gelfandRep (ofNormal T)).comp
    (ContinuousMap.compStarAlgHom' ℂ ℂ
      (normalEvalHomeomorph T : C(characterSpace ℂ (ofNormal T), spectrum ℂ T)))
  have h1 : (ContinuousMap.restrict (spectrum ℂ T) (ContinuousMap.id ℂ)).comp
      (normalEvalHomeomorph T : C(characterSpace ℂ (ofNormal T), spectrum ℂ T)) =
      gelfandTransform ℂ (ofNormal T) ⟨T, self_mem_ofNormal T⟩ := by
    ext χ
    rfl
  have hφ : φ (ContinuousMap.restrict (spectrum ℂ T) (ContinuousMap.id ℂ)) = T := by
    change gelfandRep (ofNormal T) ((ContinuousMap.restrict (spectrum ℂ T)
      (ContinuousMap.id ℂ)).comp (normalEvalHomeomorph T : C(_, _))) = T
    rw [h1, gelfandRep_gelfandTransform]
  have hcont : Continuous φ :=
    (continuous_gelfandRep (ofNormal T)).comp (ContinuousMap.continuous_precomp _)
  have key := cfcHom_eq_of_continuous_of_map_id hT φ hcont hφ
  exact (DFunLike.congr_fun key g).symm

end Normal

end CommOperatorAlgebra

end SpectralTheorem

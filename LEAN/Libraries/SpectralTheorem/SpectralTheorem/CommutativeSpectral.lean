import SpectralTheorem.RepPVM
import SpectralTheorem.CommOperatorAlgebra
import SpectralTheorem.SpectralPVM

/-!
# The spectral theorem for commutative operator algebras and commuting families

**Statement (C).**  Let `𝒜 ⊆ 𝓛(H)` be a closed commutative `⋆`-subalgebra with Gelfand spectrum
`Δ` (compact Hausdorff) and Gelfand transform `T ↦ T̂ ∈ C(Δ)`.  There is a projection-valued
measure `P` on `Δ` with `T = ∫ T̂ dP` for every `T ∈ 𝒜`, whose measures `(ψ, P ψ)` are regular;
it is unique among such p.v.m.'s (unique outright when `Δ` is metrizable); every `P_Ω` commutes
with every operator commuting with `𝒜`; and `𝒜` is simultaneously unitarily equivalent to
multiplication operators: `U T U⁻¹ = M_{T̂ ∘ F}` for all `T ∈ 𝒜`.  This is Rudin, *Functional
Analysis*, Chapter 12; for one self-adjoint operator it is Reed–Simon I, Theorem VII.8 (p. 235)
together with Theorem VII.3 (p. 227).

**Statement (J), the joint spectral theorem.**  For a family `(T i)_{i ∈ ι}` of operators
commuting with each other and with each other's adjoints there is a p.v.m. `P` on `ℂ^ι` (product
`σ`-algebra) with `T i = ∫ zᵢ dP_z` (the coordinate truncated to a ball containing `σ(T i)`, as
`ballId`), carried by the joint spectrum; it is unique for countable `ι` among the p.v.m.'s
carried by the joint spectrum; the `T i` are simultaneously unitarily equivalent to
multiplication operators; and for self-adjoint `T i` there is such a p.v.m. on `ℝ^ι`.

Proof sketch.
* (C) is statement (R) (`SpectralTheorem.repPVM`) for the Gelfand representation
  `π_𝒜 : C(Δ) → 𝓛(H)`, the inverse of the Gelfand transform: `∫ T̂ dP = π_𝒜 (T̂) = T`.  A p.v.m.
  with `∫ T̂ dQ = T` for all `T ∈ 𝒜` represents `π_𝒜`, since every `f ∈ C(Δ)` is a Gelfand
  transform; uniqueness and the commutant follow from (R) (`π_𝒜` has range `𝒜`), and the
  multiplication form from a cyclic decomposition of `π_𝒜`.
* (J) is (C) for the closed `⋆`-algebra generated by the `T i`, pushed forward along the joint
  evaluation `χ ↦ (χ (T i))_i`: the coordinate `zᵢ ∘ jointEval` is the Gelfand transform of `T i`
  and `|χ (T i)| ≤ ‖T i‖`, so the truncation does not matter.  The self-adjoint case pushes
  further forward along `z ↦ (Re zᵢ)_i`; the imaginary parts vanish on the joint spectrum.

## Main definitions and results

* `SpectralTheorem.CommOperatorAlgebra.commPVM 𝒜`: the p.v.m. of `𝒜` on its Gelfand spectrum;
  `integral_commPVM`: `T = ∫ T̂ dP`; `regular_commPVM_measure`;
  `eq_commPVM_of_regular`, `existsUnique_regular_commPVM`, and for metrizable `Δ`
  `eq_commPVM`, `existsUnique_commPVM`: uniqueness; `commute_commPVM`,
  `commute_integral_commPVM`: the commutant; `exists_unitary_mulL_gelfandTransform` and
  `exists_unitary_mulL_gelfandTransform_finite`: the simultaneous multiplication operator
  form.
* `SpectralTheorem.CommOperatorAlgebra.jointPVM T hc hc'`: the joint p.v.m. on `ℂ^ι` of a
  star-commuting family, with `coordBall i r` the truncated `i`-th coordinate and
  `integral_jointPVM_coordBall`: `T i = ∫ zᵢ dP_z`; `jointPVM_apply_eq_one`,
  `jointPVM_jointSpectrum`: it is carried by the joint spectrum; `commute_jointPVM`,
  `commute_integral_jointPVM`: the commutant; `exists_unitary_mulL_joint` and
  `exists_unitary_mulL_joint_finite`: the simultaneous multiplication operator form;
  `eq_jointPVM`, `existsUnique_jointPVM`: uniqueness for countable `ι` among the p.v.m.'s
  carried by the joint spectrum.
* `SpectralTheorem.CommOperatorAlgebra.jointPVMReal T hc hc'`: the joint p.v.m. on `ℝ^ι`, with
  `integral_jointPVMReal_coordBallReal`: `T i = ∫ xᵢ dP_x` for self-adjoint `T i`;
  `map_ofRealPi_jointPVMReal`, `exists_unitary_mulL_joint_real`, `eq_jointPVMReal`,
  `existsUnique_jointPVMReal`; `starCommute_of_isSelfAdjoint`: for self-adjoint families the
  star-commutation hypothesis follows from commutation.
* `SpectralTheorem.ProjectionValuedMeasure.comap`: the pullback of a p.v.m. along a measurable
  embedding whose range carries it, with `map_comap`.
-/

noncomputable section

open scoped InnerProductSpace ENNReal
open MeasureTheory Filter Set WeakDual

namespace SpectralTheorem

universe u

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

namespace CommOperatorAlgebra

/-! ### Statement (C): commutative operator algebras -/

section Algebra

variable (𝒜 : CommOperatorAlgebra H)

/-- **The projection-valued measure of a commutative operator algebra** `𝒜` on its Gelfand
spectrum: the p.v.m. of the Gelfand representation `π_𝒜 : C(Δ) → 𝓛(H)`. -/
def commPVM : ProjectionValuedMeasure (characterSpace ℂ 𝒜) H :=
  repPVM (gelfandRep 𝒜)

/-- `f ↦ ∫ f dP` is the Gelfand representation, for the p.v.m. `P` of `𝒜`. -/
theorem toRep_commPVM : (commPVM 𝒜).toRep = gelfandRep 𝒜 :=
  toRep_repPVM _

/-- **Statement (C), existence: `T = ∫ T̂ dP`** for every `T ∈ 𝒜`, where `T̂` is the Gelfand
transform of `T` and `P` the p.v.m. of `𝒜` (Rudin, *Functional Analysis*, Chapter 12). -/
theorem integral_commPVM (a : 𝒜) :
    (commPVM 𝒜).integral (continuousMapToBoundedMeasurable (gelfandTransform ℂ 𝒜 a)) = a := by
  rw [commPVM, integral_repPVM, gelfandRep_gelfandTransform]

/-- **The measures `(ψ, P ψ)` of the p.v.m. of `𝒜` are regular.** -/
instance regular_commPVM_measure (ψ : H) : ((commPVM 𝒜).measure ψ).Regular :=
  regular_repPVM_measure ψ

/-- The measures of the p.v.m. of `𝒜` are the spectral measures of the Gelfand
representation. -/
theorem measure_commPVM (ψ : H) : (commPVM 𝒜).measure ψ = repMeasure (gelfandRep 𝒜) ψ :=
  measure_repPVM _ ψ

variable {𝒜} in
/-- A p.v.m. `Q` on `Δ` represents the Gelfand representation of `𝒜` if and only if
`∫ T̂ dQ = T` for every `T ∈ 𝒜`: every continuous function on `Δ` is a Gelfand transform. -/
theorem toRep_eq_gelfandRep_iff {Q : ProjectionValuedMeasure (characterSpace ℂ 𝒜) H} :
    Q.toRep = gelfandRep 𝒜 ↔
      ∀ a : 𝒜, Q.integral (continuousMapToBoundedMeasurable (gelfandTransform ℂ 𝒜 a)) = a := by
  refine ⟨fun h a => ?_, fun h => StarAlgHom.ext fun f => ?_⟩
  · rw [← ProjectionValuedMeasure.toRep_apply, h, gelfandRep_gelfandTransform]
  · have e := h ⟨gelfandRep 𝒜 f, gelfandRep_mem 𝒜 f⟩
    rw [gelfandTransform_gelfandRep] at e
    rw [ProjectionValuedMeasure.toRep_apply, e]

variable {𝒜} in
/-- **Statement (C), uniqueness among regular p.v.m.'s**: a p.v.m. `Q` on `Δ` with `∫ T̂ dQ = T`
for all `T ∈ 𝒜` and with regular measures `(ψ, Q ψ)` is the p.v.m. of `𝒜`. -/
theorem eq_commPVM_of_regular {Q : ProjectionValuedMeasure (characterSpace ℂ 𝒜) H}
    (hQ : ∀ a : 𝒜, Q.integral (continuousMapToBoundedMeasurable (gelfandTransform ℂ 𝒜 a)) = a)
    (hreg : ∀ ψ, (Q.measure ψ).Regular) : Q = commPVM 𝒜 :=
  eq_repPVM_of_regular (toRep_eq_gelfandRep_iff.2 hQ) hreg

/-- **Statement (C), existence and uniqueness**: there is exactly one p.v.m. `P` on the Gelfand
spectrum of `𝒜` with `T = ∫ T̂ dP` for all `T ∈ 𝒜` and with all measures `(ψ, P ψ)` regular. -/
theorem existsUnique_regular_commPVM :
    ∃! P : ProjectionValuedMeasure (characterSpace ℂ 𝒜) H,
      (∀ a : 𝒜, P.integral (continuousMapToBoundedMeasurable (gelfandTransform ℂ 𝒜 a)) = a) ∧
        ∀ ψ, (P.measure ψ).Regular :=
  ⟨commPVM 𝒜, ⟨integral_commPVM 𝒜, fun ψ => regular_commPVM_measure 𝒜 ψ⟩,
    fun _ hQ => eq_commPVM_of_regular hQ.1 hQ.2⟩

section Metrizable

variable [TopologicalSpace.MetrizableSpace (characterSpace ℂ 𝒜)]

variable {𝒜} in
/-- **Uniqueness for metrizable `Δ`** (e.g. `𝒜` generated by countably many operators): every
p.v.m. `Q` on `Δ` with `∫ T̂ dQ = T` for all `T ∈ 𝒜` is the p.v.m. of `𝒜`. -/
theorem eq_commPVM {Q : ProjectionValuedMeasure (characterSpace ℂ 𝒜) H}
    (hQ : ∀ a : 𝒜, Q.integral (continuousMapToBoundedMeasurable (gelfandTransform ℂ 𝒜 a)) = a) :
    Q = commPVM 𝒜 :=
  eq_repPVM _ (toRep_eq_gelfandRep_iff.2 hQ)

/-- **Existence and uniqueness for metrizable `Δ`**: there is exactly one p.v.m. `P` on `Δ`
with `T = ∫ T̂ dP` for all `T ∈ 𝒜`. -/
theorem existsUnique_commPVM :
    ∃! P : ProjectionValuedMeasure (characterSpace ℂ 𝒜) H,
      ∀ a : 𝒜, P.integral (continuousMapToBoundedMeasurable (gelfandTransform ℂ 𝒜 a)) = a :=
  ⟨commPVM 𝒜, integral_commPVM 𝒜, fun _ hQ => eq_commPVM hQ⟩

end Metrizable

variable {𝒜} {B : H →L[ℂ] H}

/-- **Statement (C), the commutant**: every `P_Ω` of the p.v.m. of `𝒜` commutes with every
operator commuting with all elements of `𝒜`. -/
theorem commute_commPVM (hB : ∀ a ∈ 𝒜, Commute B a) (s : Set (characterSpace ℂ 𝒜)) :
    Commute B (commPVM 𝒜 s) :=
  commute_repPVM (fun f => hB _ (gelfandRep_mem 𝒜 f)) s

/-- An operator commuting with all elements of `𝒜` commutes with `∫ g dP` for the p.v.m. `P` of
`𝒜` and every bounded Borel `g`. -/
theorem commute_integral_commPVM (hB : ∀ a ∈ 𝒜, Commute B a)
    (g : boundedMeasurable (characterSpace ℂ 𝒜)) : Commute B ((commPVM 𝒜).integral g) :=
  commute_integral_repPVM (fun f => hB _ (gelfandRep_mem 𝒜 f)) g

variable (𝒜) in
/-- **Statement (C), multiplication operator form**: there are a measure space `(M, μ)`, a
unitary `U : H ≃ L²(M, μ)` and a measurable `F : M → Δ` with `U T U⁻¹ = M_{T̂ ∘ F}`
simultaneously for all `T ∈ 𝒜`. -/
theorem exists_unitary_mulL_gelfandTransform :
    ∃ (M : Type u) (_ : MeasurableSpace M) (μ : Measure M) (U : H ≃ₗᵢ[ℂ] Lp ℂ 2 μ)
      (F : M → characterSpace ℂ 𝒜) (_ : Measurable F),
      ∀ a : 𝒜, ∃ ha : MemLp (fun m => gelfandTransform ℂ 𝒜 a (F m)) ∞ μ,
        ∀ h : H, U ((a : H →L[ℂ] H) h) =
          mulL (fun m => gelfandTransform ℂ 𝒜 a (F m)) ha (U h) := by
  obtain ⟨M, _, μ, U, F, hF, hU⟩ := exists_unitary_mulL_rep (gelfandRep 𝒜)
  refine ⟨M, inferInstance, μ, U, F, hF, fun a => ?_⟩
  obtain ⟨ha, hU'⟩ := hU (gelfandTransform ℂ 𝒜 a)
  refine ⟨ha, fun h => ?_⟩
  rw [← hU', gelfandRep_gelfandTransform]

variable (𝒜) in
/-- **Statement (C), multiplication operator form with a finite measure** for separable `H`:
the measure `μ` of the simultaneous multiplication form can be taken finite. -/
theorem exists_unitary_mulL_gelfandTransform_finite [TopologicalSpace.SeparableSpace H] :
    ∃ (M : Type u) (_ : MeasurableSpace M) (μ : Measure M) (_ : IsFiniteMeasure μ)
      (U : H ≃ₗᵢ[ℂ] Lp ℂ 2 μ) (F : M → characterSpace ℂ 𝒜) (_ : Measurable F),
      ∀ a : 𝒜, ∃ ha : MemLp (fun m => gelfandTransform ℂ 𝒜 a (F m)) ∞ μ,
        ∀ h : H, U ((a : H →L[ℂ] H) h) =
          mulL (fun m => gelfandTransform ℂ 𝒜 a (F m)) ha (U h) := by
  obtain ⟨M, _, μ, hμ, U, F, hF, hU⟩ := exists_unitary_mulL_rep_finite (gelfandRep 𝒜)
  refine ⟨M, inferInstance, μ, hμ, U, F, hF, fun a => ?_⟩
  obtain ⟨ha, hU'⟩ := hU (gelfandTransform ℂ 𝒜 a)
  refine ⟨ha, fun h => ?_⟩
  rw [← hU', gelfandRep_gelfandTransform]

/-- **The values of a character are bounded by the norm**: `|χ(a)| ≤ ‖a‖`, since the Gelfand
transform is isometric. -/
theorem norm_apply_le (χ : characterSpace ℂ 𝒜) (a : 𝒜) : ‖χ a‖ ≤ ‖(a : H →L[ℂ] H)‖ := by
  rw [norm_coe, ← (gelfandTransform_isometry 𝒜).norm_map_of_map_zero (map_zero _) a]
  exact (gelfandTransform ℂ 𝒜 a).norm_coe_le_norm χ

/-- **The values of a character on a self-adjoint element are real.** -/
theorem apply_eq_re_of_isSelfAdjoint (χ : characterSpace ℂ 𝒜) {a : 𝒜}
    (ha : IsSelfAdjoint (a : H →L[ℂ] H)) : χ a = ((χ a).re : ℂ) := by
  have ha' : star a = a := Subtype.ext ha.star_eq
  have h : star (χ a) = χ a := by rw [← map_star, ha']
  exact (Complex.conj_eq_iff_re.mp h).symm

end Algebra

/-! ### Statement (J): the joint spectral theorem -/

section Joint

variable {ι : Type*} (T : ι → H →L[ℂ] H) (hc : ∀ i j, Commute (T i) (T j))
  (hc' : ∀ i j, Commute (T i) (star (T j)))

/-- The joint evaluation is measurable, for the product `σ`-algebra on `ℂ^ι`. -/
theorem measurable_jointEval : Measurable (jointEval T hc hc') :=
  Measurable.of_eval fun i =>
    ((continuous_apply i).comp (continuous_jointEval T hc hc')).measurable

/-- `|zᵢ| ≤ ‖T i‖` on the joint spectrum. -/
theorem norm_jointEval_le (χ : characterSpace ℂ (generated T hc hc')) (i : ι) :
    ‖jointEval T hc hc' χ i‖ ≤ ‖T i‖ :=
  norm_apply_le χ ⟨T i, mem_generated T hc hc' i⟩

/-- **The joint projection-valued measure** of a star-commuting family `(T i)_{i ∈ ι}`: the
pushforward of the p.v.m. of the generated algebra along the joint evaluation
`χ ↦ (χ (T i))_i`, a p.v.m. on `ℂ^ι` with the product `σ`-algebra. -/
def jointPVM : ProjectionValuedMeasure (ι → ℂ) H :=
  (commPVM (generated T hc hc')).map (jointEval T hc hc') (measurable_jointEval T hc hc')

/-- `P_t = Q_{jointEval⁻¹ t}` for the p.v.m. `Q` of the generated algebra. -/
theorem jointPVM_apply {t : Set (ι → ℂ)} (ht : MeasurableSet t) :
    jointPVM T hc hc' t = commPVM (generated T hc hc') (jointEval T hc hc' ⁻¹' t) :=
  ProjectionValuedMeasure.map_apply _ _ ht

/-- `∫ f dP = ∫ f ∘ jointEval dQ` for the p.v.m. `Q` of the generated algebra. -/
theorem integral_jointPVM (f : boundedMeasurable (ι → ℂ)) :
    (jointPVM T hc hc').integral f = (commPVM (generated T hc hc')).integral
      ⟨(f : (ι → ℂ) → ℂ) ∘ jointEval T hc hc',
        boundedMeasurable.comp_mem f (measurable_jointEval T hc hc')⟩ :=
  ProjectionValuedMeasure.integral_map _ _ f

/-- The `i`-th coordinate truncated to the ball of radius `r`: `z ↦ zᵢ 1_{|zᵢ| ≤ r}`, a bounded
Borel function on `ℂ^ι` (`ballId r` applied to the `i`-th coordinate). -/
def coordBall (i : ι) (r : ℝ) : boundedMeasurable (ι → ℂ) :=
  ⟨(ballId r : ℂ → ℂ) ∘ fun z => z i, boundedMeasurable.comp_mem (ballId r) (measurable_pi_apply i)⟩

theorem coordBall_apply (i : ι) (r : ℝ) (z : ι → ℂ) :
    (coordBall i r : (ι → ℂ) → ℂ) z = (ballId r : ℂ → ℂ) (z i) :=
  rfl

/-- **Statement (J), existence: `T i = ∫ zᵢ dP_z`**, with the coordinate truncated to any ball
of radius `r ≥ ‖T i‖` (which contains `σ(T i)`). -/
theorem integral_jointPVM_coordBall (i : ι) {r : ℝ} (hr : ‖T i‖ ≤ r) :
    (jointPVM T hc hc').integral (coordBall i r) = T i := by
  rw [integral_jointPVM]
  have h : (⟨((coordBall i r : boundedMeasurable (ι → ℂ)) : (ι → ℂ) → ℂ) ∘ jointEval T hc hc',
      boundedMeasurable.comp_mem _ (measurable_jointEval T hc hc')⟩ :
        boundedMeasurable (characterSpace ℂ (generated T hc hc')))
      = continuousMapToBoundedMeasurable
        (gelfandTransform ℂ (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩) :=
    Subtype.ext (funext fun χ => ballId_apply_of_mem
      (mem_closedBall_zero_iff.2 ((norm_jointEval_le T hc hc' χ i).trans hr)))
  rw [h, integral_commPVM]

/-- **The joint p.v.m. is carried by the joint spectrum**: `P_t = I` for every measurable
`t ⊇ σ(T)`.  (For countable `ι` the joint spectrum itself is measurable:
`jointPVM_jointSpectrum`.) -/
theorem jointPVM_apply_eq_one {t : Set (ι → ℂ)} (ht : MeasurableSet t)
    (hsub : jointSpectrum T hc hc' ⊆ t) : jointPVM T hc hc' t = 1 := by
  have h : jointEval T hc hc' ⁻¹' t = univ := eq_univ_of_forall fun χ =>
    hsub (range_jointEval T hc hc' ▸ mem_range_self χ)
  rw [jointPVM_apply T hc hc' ht, h, ProjectionValuedMeasure.univ]

/-- `P_t = 0` for every measurable `t` disjoint from the joint spectrum. -/
theorem jointPVM_apply_eq_zero {t : Set (ι → ℂ)} (ht : MeasurableSet t)
    (hdisj : Disjoint (jointSpectrum T hc hc') t) : jointPVM T hc hc' t = 0 := by
  have h : jointEval T hc hc' ⁻¹' t = ∅ := eq_empty_of_forall_notMem fun χ hχ =>
    hdisj.notMem_of_mem_left (range_jointEval T hc hc' ▸ mem_range_self χ) hχ
  rw [jointPVM_apply T hc hc' ht, h, ProjectionValuedMeasure.empty]

/-- For countable `ι` the joint spectrum is a Borel set of `ℂ^ι` (it is compact). -/
theorem measurableSet_jointSpectrum [Countable ι] : MeasurableSet (jointSpectrum T hc hc') :=
  (isCompact_jointSpectrum T hc hc').isClosed.measurableSet

/-- **The joint p.v.m. is supported on the joint spectrum** (countable `ι`): `P_{σ(T)} = I`. -/
theorem jointPVM_jointSpectrum [Countable ι] : jointPVM T hc hc' (jointSpectrum T hc hc') = 1 :=
  jointPVM_apply_eq_one T hc hc' (measurableSet_jointSpectrum T hc hc') subset_rfl

/-- An operator commuting with every `T i` and every `T i†` commutes with every element of the
closed `⋆`-algebra generated by the `T i`: that algebra lies in the `⋆`-commutant of `B`. -/
theorem commute_of_mem_generated {B : H →L[ℂ] H} (hB : ∀ i, Commute B (T i))
    (hB' : ∀ i, Commute B (star (T i))) {a : H →L[ℂ] H} (ha : a ∈ generated T hc hc') :
    Commute B a := by
  have hT : ∀ i, T i ∈ StarSubalgebra.centralizer ℂ ({B} : Set (H →L[ℂ] H)) := fun i => by
    rw [StarSubalgebra.mem_centralizer_iff]
    rintro g rfl
    refine ⟨(hB i).eq, ?_⟩
    have h := (hB' i).star_star
    rw [star_star] at h
    exact h.eq
  have hle := generated_le_of_isClosed T hc hc' (S := StarSubalgebra.centralizer ℂ {B})
    (Set.isClosed_centralizer _) hT ha
  rw [StarSubalgebra.mem_centralizer_iff] at hle
  exact (hle B rfl).1

/-- **Statement (J), the commutant**: every `P_t` of the joint p.v.m. commutes with every
operator commuting with all `T i` and `T i†`. -/
theorem commute_jointPVM {B : H →L[ℂ] H} (hB : ∀ i, Commute B (T i))
    (hB' : ∀ i, Commute B (star (T i))) (t : Set (ι → ℂ)) : Commute B (jointPVM T hc hc' t) := by
  by_cases ht : MeasurableSet t
  · rw [jointPVM_apply T hc hc' ht]
    exact commute_commPVM (fun a ha => commute_of_mem_generated T hc hc' hB hB' ha) _
  · rw [ProjectionValuedMeasure.apply_of_not_measurableSet _ ht]
    exact Commute.zero_right B

/-- An operator commuting with all `T i` and `T i†` commutes with `∫ g dP` for the joint p.v.m.
`P` and every bounded Borel `g` on `ℂ^ι`. -/
theorem commute_integral_jointPVM {B : H →L[ℂ] H} (hB : ∀ i, Commute B (T i))
    (hB' : ∀ i, Commute B (star (T i))) (g : boundedMeasurable (ι → ℂ)) :
    Commute B ((jointPVM T hc hc').integral g) :=
  (jointPVM T hc hc').commute_integral_of_forall_commute (commute_jointPVM T hc hc' hB hB') g

/-- **Statement (J), multiplication operator form**: there are a measure space `(M, μ)`, a
unitary `U : H ≃ L²(M, μ)` and a measurable `F : M → ℂ^ι` with values in the joint spectrum such
that `U (T i) U⁻¹ = M_{Fᵢ}` simultaneously for all `i`. -/
theorem exists_unitary_mulL_joint :
    ∃ (M : Type u) (_ : MeasurableSpace M) (μ : Measure M) (U : H ≃ₗᵢ[ℂ] Lp ℂ 2 μ)
      (F : M → ι → ℂ) (_ : Measurable F) (_ : ∀ m, F m ∈ jointSpectrum T hc hc'),
      ∀ i, ∃ hi : MemLp (fun m => F m i) ∞ μ,
        ∀ h : H, U (T i h) = mulL (fun m => F m i) hi (U h) := by
  obtain ⟨M, _, μ, U, F, hF, hU⟩ := exists_unitary_mulL_gelfandTransform (generated T hc hc')
  exact ⟨M, inferInstance, μ, U, jointEval T hc hc' ∘ F, (measurable_jointEval T hc hc').comp hF,
    fun m => range_jointEval T hc hc' ▸ mem_range_self (F m),
    fun i => hU ⟨T i, mem_generated T hc hc' i⟩⟩

/-- **Statement (J), multiplication operator form with a finite measure** for separable `H`. -/
theorem exists_unitary_mulL_joint_finite [TopologicalSpace.SeparableSpace H] :
    ∃ (M : Type u) (_ : MeasurableSpace M) (μ : Measure M) (_ : IsFiniteMeasure μ)
      (U : H ≃ₗᵢ[ℂ] Lp ℂ 2 μ) (F : M → ι → ℂ) (_ : Measurable F)
      (_ : ∀ m, F m ∈ jointSpectrum T hc hc'),
      ∀ i, ∃ hi : MemLp (fun m => F m i) ∞ μ,
        ∀ h : H, U (T i h) = mulL (fun m => F m i) hi (U h) := by
  obtain ⟨M, _, μ, hμ, U, F, hF, hU⟩ :=
    exists_unitary_mulL_gelfandTransform_finite (generated T hc hc')
  exact ⟨M, inferInstance, μ, hμ, U, jointEval T hc hc' ∘ F,
    (measurable_jointEval T hc hc').comp hF,
    fun m => range_jointEval T hc hc' ▸ mem_range_self (F m),
    fun i => hU ⟨T i, mem_generated T hc hc' i⟩⟩

/-! ### Self-adjoint families: a projection-valued measure on `ℝ^ι` -/

/-- The real parts of the coordinates, `z ↦ (Re zᵢ)_i`. -/
def rePi (z : ι → ℂ) : ι → ℝ :=
  fun i => (z i).re

/-- The inclusion `ℝ^ι → ℂ^ι`. -/
def ofRealPi (x : ι → ℝ) : ι → ℂ :=
  fun i => (x i : ℂ)

theorem measurable_rePi : Measurable (rePi (ι := ι)) :=
  Measurable.of_eval fun i => Complex.measurable_re.comp (measurable_pi_apply i)

theorem measurable_ofRealPi : Measurable (ofRealPi (ι := ι)) :=
  Measurable.of_eval fun i => Complex.measurable_ofReal.comp (measurable_pi_apply i)

/-- **The joint projection-valued measure on `ℝ^ι`** of a star-commuting family: the pushforward
of the joint p.v.m. along `z ↦ (Re zᵢ)_i`.  For self-adjoint `T i` it represents the family
(`integral_jointPVMReal_coordBallReal`). -/
def jointPVMReal : ProjectionValuedMeasure (ι → ℝ) H :=
  (jointPVM T hc hc').map rePi measurable_rePi

/-- The `i`-th real coordinate truncated to `[-r, r]`: `x ↦ xᵢ 1_{|xᵢ| ≤ r}`, as a complex
bounded Borel function on `ℝ^ι`. -/
def coordBallReal (i : ι) (r : ℝ) : boundedMeasurable (ι → ℝ) :=
  ⟨(ballId r : ℂ → ℂ) ∘ fun x => ((x i : ℝ) : ℂ), boundedMeasurable.comp_mem (ballId r)
    (Complex.measurable_ofReal.comp (measurable_pi_apply i))⟩

theorem coordBallReal_apply (i : ι) (r : ℝ) (x : ι → ℝ) :
    (coordBallReal i r : (ι → ℝ) → ℂ) x = (ballId r : ℂ → ℂ) (x i) :=
  rfl

/-- **Statement (J), self-adjoint case: `T i = ∫ xᵢ dP_x`** for the p.v.m. `P` on `ℝ^ι`, when
`T i` is self-adjoint, with the coordinate truncated to `[-r, r]` for any `r ≥ ‖T i‖`.  On the
joint spectrum the `i`-th coordinate is real. -/
theorem integral_jointPVMReal_coordBallReal (i : ι) (hsa : IsSelfAdjoint (T i)) {r : ℝ}
    (hr : ‖T i‖ ≤ r) : (jointPVMReal T hc hc').integral (coordBallReal i r) = T i := by
  rw [jointPVMReal, ProjectionValuedMeasure.integral_map,
    ← integral_jointPVM_coordBall T hc hc' i hr, integral_jointPVM, integral_jointPVM]
  congr 1
  refine Subtype.ext (funext fun χ => ?_)
  exact congrArg (ballId r : ℂ → ℂ)
    (apply_eq_re_of_isSelfAdjoint χ (a := ⟨T i, mem_generated T hc hc' i⟩) hsa).symm

/-- The p.v.m. on `ℝ^ι` is carried by the real parts of the joint spectrum: `P_t = I` for
every measurable `t` containing them. -/
theorem jointPVMReal_apply_eq_one {t : Set (ι → ℝ)} (ht : MeasurableSet t)
    (hsub : rePi '' jointSpectrum T hc hc' ⊆ t) : jointPVMReal T hc hc' t = 1 := by
  rw [jointPVMReal, ProjectionValuedMeasure.map_apply _ _ ht]
  exact jointPVM_apply_eq_one T hc hc' (measurable_rePi ht) fun z hz => hsub ⟨z, hz, rfl⟩

/-- For a self-adjoint family the joint spectrum is real: `(Re zᵢ)_i = z` on it. -/
theorem ofRealPi_rePi_of_mem_jointSpectrum (hsa : ∀ i, IsSelfAdjoint (T i)) {z : ι → ℂ}
    (hz : z ∈ jointSpectrum T hc hc') : ofRealPi (rePi z) = z := by
  obtain ⟨χ, hχ⟩ := hz
  refine funext fun i => ?_
  have h := apply_eq_re_of_isSelfAdjoint χ (a := ⟨T i, mem_generated T hc hc' i⟩) (hsa i)
  rw [hχ i] at h
  exact h.symm

/-- **Statement (J), multiplication operator form for a self-adjoint family**: the function
`F : M → ℝ^ι` of the simultaneous multiplication form can be taken real-valued, with values in
the joint spectrum. -/
theorem exists_unitary_mulL_joint_real (hsa : ∀ i, IsSelfAdjoint (T i)) :
    ∃ (M : Type u) (_ : MeasurableSpace M) (μ : Measure M) (U : H ≃ₗᵢ[ℂ] Lp ℂ 2 μ)
      (F : M → ι → ℝ) (_ : Measurable F) (_ : ∀ m, ofRealPi (F m) ∈ jointSpectrum T hc hc'),
      ∀ i, ∃ hi : MemLp (fun m => ((F m i : ℝ) : ℂ)) ∞ μ,
        ∀ h : H, U (T i h) = mulL (fun m => ((F m i : ℝ) : ℂ)) hi (U h) := by
  obtain ⟨M, _, μ, U, G, hG, hGmem, hU⟩ := exists_unitary_mulL_joint T hc hc'
  have hre : ∀ m, ofRealPi (rePi (G m)) = G m := fun m =>
    ofRealPi_rePi_of_mem_jointSpectrum T hc hc' hsa (hGmem m)
  refine ⟨M, inferInstance, μ, U, fun m => rePi (G m), measurable_rePi.comp hG,
    fun m => (hre m).symm ▸ hGmem m, fun i => ?_⟩
  have hfun : (fun m => ((rePi (G m) i : ℝ) : ℂ)) = fun m => G m i :=
    funext fun m => congrFun (hre m) i
  rw [hfun]
  exact hU i

/-- For self-adjoint operators, commuting implies star-commuting, so the hypotheses of the joint
spectral theorem reduce to `Commute (T i) (T j)`. -/
theorem starCommute_of_isSelfAdjoint {S : ι → H →L[ℂ] H} (hsa : ∀ i, IsSelfAdjoint (S i))
    (h : ∀ i j, Commute (S i) (S j)) (i j : ι) : Commute (S i) (star (S j)) := by
  rw [(hsa j).star_eq]
  exact h i j

/-- **For a self-adjoint family the joint p.v.m. on `ℂ^ι` is the image of the one on `ℝ^ι`**
under the inclusion `ℝ^ι → ℂ^ι`: the joint spectrum is real. -/
theorem map_ofRealPi_jointPVMReal (hsa : ∀ i, IsSelfAdjoint (T i)) :
    (jointPVMReal T hc hc').map ofRealPi measurable_ofRealPi = jointPVM T hc hc' := by
  rw [jointPVMReal, ProjectionValuedMeasure.map_map, jointPVM,
    ProjectionValuedMeasure.map_map]
  have h : (ofRealPi ∘ rePi) ∘ jointEval T hc hc' = jointEval T hc hc' :=
    funext fun χ => funext fun i =>
      (apply_eq_re_of_isSelfAdjoint χ (a := ⟨T i, mem_generated T hc hc' i⟩) (hsa i)).symm
  refine ProjectionValuedMeasure.ext fun t ht => ?_
  rw [ProjectionValuedMeasure.map_apply _ _ ht, ProjectionValuedMeasure.map_apply _ _ ht, h]

end Joint

end CommOperatorAlgebra

/-! ### The pullback of a projection-valued measure along a measurable embedding -/

namespace ProjectionValuedMeasure

section Comap

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y] (Q : ProjectionValuedMeasure Y H)
variable {F : X → Y} (hF : MeasurableEmbedding F) (hQ : Q (Set.range F) = 1)

open Classical in
/-- **The pullback of a projection-valued measure** `Q` on `Y` along a measurable embedding
`F : X → Y` whose range carries `Q` (`Q_{F(X)} = I`): `s ↦ Q_{F(s)}` on measurable sets. -/
def comap : ProjectionValuedMeasure X H where
  toFun s := if MeasurableSet s then Q (F '' s) else 0
  isStarProjection' s hs := by
    rw [ite_eq_left hs]
    exact Q.isStarProjection (hF.measurableSet_image' hs)
  empty' := by rw [ite_eq_left MeasurableSet.empty, Set.image_empty, Q.empty]
  univ' := by rw [ite_eq_left MeasurableSet.univ, Set.image_univ, hQ]
  tendsto_sum' s hs hd ψ := by
    simp only [hs, MeasurableSet.iUnion hs, ite_true, Set.image_iUnion]
    exact Q.tendsto_sum _ (fun n => hF.measurableSet_image' (hs n))
      (fun i j hij => (Set.disjoint_image_iff hF.injective).2 (hd hij)) ψ
  apply_of_not_measurableSet' s hs := ite_eq_right hs

theorem comap_apply {s : Set X} (hs : MeasurableSet s) : Q.comap hF hQ s = Q (F '' s) := by
  classical
  exact ite_eq_left hs

/-- A set containing a set of full measure has full measure: `Q_B = Q_{A ∩ B} = Q_A = I`. -/
theorem apply_eq_one_of_subset {A B : Set Y} (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hQA : Q A = 1) (hAB : A ⊆ B) : Q B = 1 := by
  rw [← Q.apply_inter_of_eq_one hA hB hQA, Set.inter_eq_left.mpr hAB, hQA]

/-- The pushforward of the pullback of `Q` is `Q`, since `Q` is carried by the range of `F`. -/
theorem map_comap : (Q.comap hF hQ).map F hF.measurable = Q :=
  ProjectionValuedMeasure.ext fun t ht => by
    rw [map_apply _ _ ht, comap_apply _ hF hQ (hF.measurable ht),
      Set.image_preimage_eq_inter_range, Set.inter_comm,
      Q.apply_inter_of_eq_one hF.measurableSet_range ht hQ]

end Comap

end ProjectionValuedMeasure

namespace CommOperatorAlgebra

/-! ### Statement (J): uniqueness for a countable family -/

section Unique

variable {ι : Type*} (T : ι → H →L[ℂ] H) (hc : ∀ i j, Commute (T i) (T j))
  (hc' : ∀ i j, Commute (T i) (star (T j)))

open scoped CStarAlgebra in
/-- **Two `⋆`-homomorphisms on `C(Δ)` agreeing on the Gelfand transforms of the generators are
equal**, `Δ` the Gelfand spectrum of the algebra generated by a star-commuting family: they are
continuous (`⋆`-homomorphisms of C*-algebras), so the elements of the generated algebra where
the induced maps agree form a closed `⋆`-subalgebra containing the `T i`. -/
theorem starAlgHom_ext_generated
    {φ ψ : C(characterSpace ℂ (generated T hc hc'), ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)}
    (h : ∀ i, φ (gelfandTransform ℂ (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩) =
      ψ (gelfandTransform ℂ (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩)) : φ = ψ := by
  let e := gelfandStarTransform (generated T hc hc')
  have hcont : Continuous e := (gelfandTransform_isometry (generated T hc hc')).continuous
  let S : StarSubalgebra ℂ (H →L[ℂ] H) :=
    (StarAlgHom.equalizer (φ.comp e.toStarAlgHom) (ψ.comp e.toStarAlgHom)).map
      (generated T hc hc').subtype
  have hS : IsClosed (S : Set (H →L[ℂ] H)) := by
    rw [StarSubalgebra.coe_map]
    exact (generated T hc hc').isClosed.isClosedMap_subtype_val _
      (isClosed_eq ((map_continuous φ).comp hcont) ((map_continuous ψ).comp hcont))
  have hle := generated_le_of_isClosed T hc hc' hS
    fun i => ⟨⟨T i, mem_generated T hc hc' i⟩, h i, rfl⟩
  refine StarAlgHom.ext fun f => ?_
  obtain ⟨a, rfl⟩ := e.surjective f
  obtain ⟨y, hy, hya⟩ := hle a.2
  have hya' : y = a := Subtype.ext hya
  rw [← hya']
  exact hy

/-- The `i`-th truncated coordinate composed with the joint evaluation is the Gelfand transform
of `T i`, for any truncation radius `r ≥ ‖T i‖`. -/
theorem coordBall_comp_jointEval (i : ι) {r : ℝ} (hr : ‖T i‖ ≤ r) :
    (⟨((coordBall i r : boundedMeasurable (ι → ℂ)) : (ι → ℂ) → ℂ) ∘ jointEval T hc hc',
      boundedMeasurable.comp_mem _ (measurable_jointEval T hc hc')⟩ :
        boundedMeasurable (characterSpace ℂ (generated T hc hc'))) =
      continuousMapToBoundedMeasurable
        (gelfandTransform ℂ (generated T hc hc') ⟨T i, mem_generated T hc hc' i⟩) :=
  Subtype.ext (funext fun χ => ballId_apply_of_mem
    (mem_closedBall_zero_iff.2 ((norm_jointEval_le T hc hc' χ i).trans hr)))

/-- **Statement (J), uniqueness for countable `ι`**: a projection-valued measure `Q` on `ℂ^ι`
carried by the joint spectrum with `T i = ∫ zᵢ dQ_z` for all `i` is the joint p.v.m.  Pulling `Q`
back along the joint evaluation (a closed, hence measurable, embedding) gives a p.v.m. on the
Gelfand spectrum `Δ` of the generated algebra representing its Gelfand representation, and `Δ` is
metrizable for countable `ι`, so that p.v.m. is unique. -/
theorem eq_jointPVM [Countable ι] {Q : ProjectionValuedMeasure (ι → ℂ) H}
    (hQ : Q (jointSpectrum T hc hc') = 1) {r : ι → ℝ} (hr : ∀ i, ‖T i‖ ≤ r i)
    (hint : ∀ i, Q.integral (coordBall i (r i)) = T i) : Q = jointPVM T hc hc' := by
  have hE : MeasurableEmbedding (jointEval T hc hc') :=
    (isClosedEmbedding_jointEval T hc hc').measurableEmbedding
  have hQ' : Q (Set.range (jointEval T hc hc')) = 1 := by
    rw [range_jointEval]
    exact hQ
  have hmap : (Q.comap hE hQ').map (jointEval T hc hc') (measurable_jointEval T hc hc') = Q :=
    Q.map_comap hE hQ'
  have hrep : (Q.comap hE hQ').toRep = gelfandRep (generated T hc hc') := by
    refine starAlgHom_ext_generated T hc hc' fun i => ?_
    rw [gelfandRep_gelfandTransform, ProjectionValuedMeasure.toRep_apply,
      ← coordBall_comp_jointEval T hc hc' i (hr i),
      ← ProjectionValuedMeasure.integral_map _ (measurable_jointEval T hc hc'), hmap, hint i]
  have h1 : Q.comap hE hQ' = commPVM (generated T hc hc') := eq_repPVM _ hrep
  rw [← hmap, h1]
  rfl

/-- **Statement (J), existence and uniqueness for countable `ι`**: there is exactly one
projection-valued measure on `ℂ^ι` carried by the joint spectrum with `T i = ∫ zᵢ dP_z` for all
`i` (the coordinates truncated to the balls of radius `‖T i‖`). -/
theorem existsUnique_jointPVM [Countable ι] :
    ∃! P : ProjectionValuedMeasure (ι → ℂ) H, P (jointSpectrum T hc hc') = 1 ∧
      ∀ i, P.integral (coordBall i ‖T i‖) = T i :=
  ⟨jointPVM T hc hc', ⟨jointPVM_jointSpectrum T hc hc',
    fun i => integral_jointPVM_coordBall T hc hc' i le_rfl⟩,
    fun _ hP => eq_jointPVM T hc hc' hP.1 (fun _ => le_rfl) hP.2⟩

/-! ### Self-adjoint families: uniqueness on `ℝ^ι` -/

/-- The inclusion `ℝ^ι → ℂ^ι` is a measurable embedding for countable `ι`: the image of a
measurable set is the intersection of the (measurable) real points with a preimage. -/
theorem measurableEmbedding_ofRealPi [Countable ι] :
    MeasurableEmbedding (ofRealPi (ι := ι)) where
  injective x y h := funext fun i => Complex.ofReal_injective (congrFun h i)
  measurable := measurable_ofRealPi
  measurableSet_image' := by
    intro s hs
    have h : ofRealPi '' s = (⋂ i : ι, {z : ι → ℂ | (z i).im = 0}) ∩ rePi ⁻¹' s := by
      ext z
      refine ⟨?_, ?_⟩
      · rintro ⟨x, hx, rfl⟩
        refine ⟨mem_iInter.2 fun i => Complex.ofReal_im (x i), ?_⟩
        have hx' : rePi (ofRealPi x) = x := funext fun i => Complex.ofReal_re (x i)
        rw [mem_preimage, hx']
        exact hx
      · rintro ⟨h1, h2⟩
        refine ⟨rePi z, h2, funext fun i => Complex.ext rfl ?_⟩
        show ((rePi z i : ℝ) : ℂ).im = (z i).im
        rw [Complex.ofReal_im]
        exact (mem_iInter.1 h1 i).symm
    rw [h]
    refine MeasurableSet.inter (MeasurableSet.iInter fun i => ?_) (measurable_rePi hs)
    exact Complex.measurable_im.comp (measurable_pi_apply i) (measurableSet_singleton 0)

/-- The real parts of the joint spectrum form a compact, hence measurable, subset of `ℝ^ι`
(for countable `ι`). -/
theorem measurableSet_rePi_image [Countable ι] :
    MeasurableSet (rePi '' jointSpectrum T hc hc') :=
  ((isCompact_jointSpectrum T hc hc').image
    (continuous_pi fun i => Complex.continuous_re.comp (continuous_apply i))).isClosed.measurableSet

/-- **Statement (J), uniqueness of the p.v.m. on `ℝ^ι`** for a countable self-adjoint family: a
p.v.m. `Q` on `ℝ^ι` carried by the real parts of the joint spectrum with `T i = ∫ xᵢ dQ_x` for
all `i` is the p.v.m. `jointPVMReal`.  Its image on `ℂ^ι` satisfies the hypotheses of
`eq_jointPVM`, and a p.v.m. is determined by its image under a measurable embedding. -/
theorem eq_jointPVMReal [Countable ι] (hsa : ∀ i, IsSelfAdjoint (T i))
    {Q : ProjectionValuedMeasure (ι → ℝ) H} (hQ : Q (rePi '' jointSpectrum T hc hc') = 1)
    {r : ι → ℝ} (hr : ∀ i, ‖T i‖ ≤ r i)
    (hint : ∀ i, Q.integral (coordBallReal i (r i)) = T i) : Q = jointPVMReal T hc hc' := by
  have hreal : ∀ z ∈ jointSpectrum T hc hc', ofRealPi (rePi z) = z := fun _ hz =>
    ofRealPi_rePi_of_mem_jointSpectrum T hc hc' hsa hz
  have hmapQ : Q.map ofRealPi measurable_ofRealPi = jointPVM T hc hc' := by
    refine eq_jointPVM T hc hc' ?_ hr fun i => ?_
    · rw [ProjectionValuedMeasure.map_apply _ _ (measurableSet_jointSpectrum T hc hc')]
      refine Q.apply_eq_one_of_subset (measurableSet_rePi_image T hc hc')
        (measurable_ofRealPi (measurableSet_jointSpectrum T hc hc')) hQ ?_
      rintro _ ⟨z, hz, rfl⟩
      rw [mem_preimage, hreal z hz]
      exact hz
    · have h : (⟨((coordBall i (r i) : boundedMeasurable (ι → ℂ)) : (ι → ℂ) → ℂ) ∘ ofRealPi,
          boundedMeasurable.comp_mem _ measurable_ofRealPi⟩ : boundedMeasurable (ι → ℝ)) =
          coordBallReal i (r i) := Subtype.ext rfl
      rw [ProjectionValuedMeasure.integral_map, h, hint i]
  have hE := measurableEmbedding_ofRealPi (ι := ι)
  refine ProjectionValuedMeasure.ext fun s hs => ?_
  have h1 : Q s = (Q.map ofRealPi measurable_ofRealPi) (ofRealPi '' s) := by
    rw [ProjectionValuedMeasure.map_apply _ _ (hE.measurableSet_image' hs),
      hE.injective.preimage_image]
  have h2 : jointPVMReal T hc hc' s =
      (jointPVM T hc hc') (ofRealPi '' s) := by
    rw [← map_ofRealPi_jointPVMReal T hc hc' hsa,
      ProjectionValuedMeasure.map_apply _ _ (hE.measurableSet_image' hs),
      hE.injective.preimage_image]
  rw [h1, hmapQ, h2]

/-- **Statement (J), the self-adjoint joint spectral theorem for countable families**: for
countably many commuting self-adjoint operators there is exactly one projection-valued measure
on `ℝ^ι` carried by the real parts of the joint spectrum with `T i = ∫ xᵢ dP_x` for all `i`. -/
theorem existsUnique_jointPVMReal [Countable ι] (hsa : ∀ i, IsSelfAdjoint (T i)) :
    ∃! P : ProjectionValuedMeasure (ι → ℝ) H, P (rePi '' jointSpectrum T hc hc') = 1 ∧
      ∀ i, P.integral (coordBallReal i ‖T i‖) = T i :=
  ⟨jointPVMReal T hc hc', ⟨jointPVMReal_apply_eq_one T hc hc'
      (measurableSet_rePi_image T hc hc') subset_rfl,
    fun i => integral_jointPVMReal_coordBallReal T hc hc' i (hsa i) le_rfl⟩,
    fun _ hP => eq_jointPVMReal T hc hc' hsa hP.1 (fun _ => le_rfl) hP.2⟩

end Unique

end CommOperatorAlgebra

end SpectralTheorem
